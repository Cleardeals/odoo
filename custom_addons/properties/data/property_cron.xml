<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================
             CRON 1 — API sync  (DISABLED — replaced by inbound webhooks)
             Source: api.cleardeals.cc/api/v1/properties
             Writes: API-sourced fields only (see API_WRITABLE_FIELDS in
                     property_sync.py).  Never writes manager-editable fields.

             As of 19.0.1.4.0 the website pushes property create/update events
             to /api/v1/properties/webhook/{create,update} (controllers/webhooks.py),
             so this polling cron is left INACTIVE.  The method and the manual
             "Sync Properties from API" button are kept for backfill /
             reconciliation if a webhook is ever missed.
             NOTE: this file is noupdate="1", so on an already-installed DB the
             active=False below does not apply on upgrade — the
             migrations/19.0.1.4.0/post-disable_cron.py script handles that.
        ================================================================ -->
        <record id="ir_cron_sync_properties_from_api" model="ir.cron">
            <field name="name">Properties: Sync from Website API</field>
            <field name="model_id" ref="model_property_base"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_from_api()</field>
            <field name="interval_number">3</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

        <!-- ================================================================
             CRON 2 — One-time migration from property.inventory  (daily 01:00)
             Reads property.inventory records from Odoo (BQ-synced already)
             and populates manager-editable fields on the matching property.base
             records by matching on property_link.
             Relinks property.lead.suggestion FKs in the same pass.
             Safe to run after property.inventory is removed — exits cleanly.
        ================================================================ -->
        <record id="ir_cron_sync_properties_from_inventory" model="ir.cron">
            <field name="name">Properties: Migrate from property.inventory</field>
            <field name="model_id" ref="model_property_base"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_from_inventory()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- ================================================================
             CRON 3 — Expiry cleanup  (daily 00:30)
             Marks properties inactive when service_expiry_date < today.
             Only touches is_active.
        ================================================================ -->
        <record id="ir_cron_cleanup_expired_properties" model="ir.cron">
            <field name="name">Properties: Mark Expired as Inactive</field>
            <field name="model_id" ref="model_property_base"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_expired_properties()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <!-- ================================================================
             Server action — Manual sync trigger (bound to property.base list)
             Only visible to users in group_property_manager.
        ================================================================ -->
        <record id="action_manual_sync_properties" model="ir.actions.server">
            <field name="name">Sync Properties from API</field>
            <field name="model_id" ref="model_property_base"/>
            <field name="binding_model_id" ref="model_property_base"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">model.action_manual_sync()</field>
        </record>

    </data>
</odoo>
