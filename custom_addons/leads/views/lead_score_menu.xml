<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Your existing Lead Scoring Menu Root -->
    <menuitem id="lead_score_menu_root"
              name="Lead Scoring"
              sequence="5"/>

    <!-- Your existing 'Leads' main menu -->
    <menuitem id="lead_score_menu_main"
              name="Leads"
              parent="lead_score_menu_root"
              sequence="10"/>

    <!-- Your existing 'All Leads' (for scored leads) -->
    <menuitem id="lead_score_menu_action"
              name="All Leads"
              parent="lead_score_menu_main"
              action="lead_score_action"
              sequence="10"/>

    <!-- Your existing 'My Actionable Leads' (for scored leads) -->
    <menuitem id="lead_score_menu_rm"
              name="My Actionable Leads"
              parent="lead_score_menu_main"
              action="lead_score_action_rm"
              groups="leads.group_lead_score_rm"
              sequence="15"/>
              
    <menuitem id="imported_leads_menu_action"
              name="Imported CSV Leads"
              parent="lead_score_menu_root"
              action="leads.action_imported_leads"
              groups="leads.group_lead_score_rm,leads.group_lead_score_manager"
              sequence="17"/>

    <!-- Your existing 'Import Leads' (BQ) -->
    <menuitem id="menu_import_leads_from_bq"
              name="Import Leads (BQ)"
              parent="lead_score_menu_main"
              action="action_open_lead_score_bq_wizard"
              sequence="20"/>
              
    <!-- === NEW MENU ITEM FOR THE CSV WIZARD === -->
    <menuitem id="menu_import_leads_from_csv"
              name="Import Leads (CSV)"
              parent="imported_leads_menu_action"
              action="leads.action_open_lead_csv_import_wizard"
              groups="leads.group_lead_score_manager"
              sequence="21"/>

</odoo>

