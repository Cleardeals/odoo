<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form view for the CSV import wizard -->
        <record id="view_lead_csv_import_wizard_form" model="ir.ui.view">
            <field name="name">lead.csv.import.wizard.form</field>
            <field name="model">lead.csv.import.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="file_data" filename="filename" widget="binary"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <footer>
                        <button name="import_leads_from_csv"
                                string="Import"
                                type="object"
                                class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action to open the CSV import wizard -->
        <record id="action_open_lead_csv_import_wizard" model="ir.actions.act_window">
            <field name="name">Import Leads (CSV)</field>
            <field name="res_model">lead.csv.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Form view for the error/message wizard -->
        <record id="view_message_wizard_form" model="ir.ui.view">
            <field name="name">message.wizard.form</field>
            <field name="model">message.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <field name="message" widget="text_pre" readonly="1"/>
                    <footer>
                        <button string="Close" class="btn-primary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>

