<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bulk Reassign Wizard Form -->
    <record id="view_lead_bulk_reassign_wizard_form" model="ir.ui.view">
        <field name="name">lead.bulk.reassign.wizard.form</field>
        <field name="model">lead.bulk.reassign.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Reassign RM">

                <!-- PREVIEW STATE -->
                <group invisible="state != 'preview'">

                    <div class="alert alert-danger" role="alert"
                         invisible="not over_limit">
                        <strong>Too many leads selected.</strong><br/>
                        You selected <field name="lead_count" readonly="1" nolabel="1"
                        class="oe_inline"/> leads, but at most
                        <field name="max_leads" readonly="1" nolabel="1" class="oe_inline"/>
                        can be reassigned in one operation.
                        Narrow your filter (e.g. by status, date or property) and try again.
                    </div>

                    <group invisible="over_limit">
                        <field name="lead_count" readonly="1"/>
                        <field name="source_rm_summary" readonly="1"/>
                        <field name="new_rm_id"
                               required="1"
                               options="{'no_create': True}"
                               placeholder="Select the RM to move these leads to"/>
                        <field name="reason" required="1"
                               placeholder="Why are these leads being reassigned? (required)"/>
                        <field name="cascade_site_visits"/>
                        <div class="text-muted" colspan="2">
                            The RM change is logged on each lead's chatter and recorded in the
                            Reassignment Log. BDE links on OPS-sale leads are left unchanged.
                        </div>
                    </group>
                </group>

                <!-- DONE STATE -->
                <group invisible="state != 'done'" string="Reassignment Complete">
                    <field name="reassigned_count" readonly="1"/>
                    <field name="skipped_count" readonly="1"
                           invisible="skipped_count == 0"/>
                    <field name="site_visits_moved_count" readonly="1"/>
                    <div class="alert alert-success" role="alert" colspan="2">
                        Leads were reassigned to
                        <field name="new_rm_id" readonly="1" nolabel="1" class="oe_inline"/>.
                        A batch record was created in the Reassignment Log.
                    </div>
                </group>

                <footer>
                    <button name="action_confirm_reassign"
                            string="Reassign Leads"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'preview' or over_limit or lead_count == 0"
                            confirm="This will move the selected leads (and their site visits) to the chosen RM. Proceed?"/>

                    <button name="action_view_batch"
                            string="View Batch Log"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'done'"/>

                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server action bound to the leads.new list "Action" menu.
         The web client puts the selection (manual tick or "select all matching")
         into context.active_ids, which the wizard's default_get reads. -->
    <record id="action_bulk_reassign_leads" model="ir.actions.server">
        <field name="name">Bulk Reassign RM</field>
        <field name="model_id" ref="leads.model_leads_new"/>
        <field name="binding_model_id" ref="leads.model_leads_new"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('leads.group_lead_score_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['lead.bulk.reassign.wizard'].create({}).action_open()</field>
    </record>

</odoo>
