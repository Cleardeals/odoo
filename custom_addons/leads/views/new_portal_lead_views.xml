<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="leads_new_view_search" model="ir.ui.view">
        <field name="name">leads.new.search</field>
        <field name="model">leads.new</field>
        <field name="arch" type="xml">
            <search string="Search New Portal Leads">
                <field name="name" string="Lead Name"/>
                <field name="phone"/>
                <field name="user_id" string="RM"/>
                <field name="base_property_location" string="Location"/>
                <field name="base_property_tag" string="Property Tag"/>
                <field name="all_associated_properties" string="Property (Primary or Recommended)"/>
                <field name="base_property_bhk" string="BHK"/>
                <field name="base_property_city" string="City"/>
                <field name="source_id"/>
                <field name="current_status"/>

                <separator/>

                <filter string="Created: Today"
                        name="created_today"
                        domain="[('create_date_only', '=', context_today())]"/>

                <filter string="Created: Yesterday"
                        name="created_yesterday"
                        domain="[('create_date_only', '=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>

                <filter string="Created: Last 7 Days"
                        name="created_last_7_days"
                        domain="[('create_date_only', '&gt;=', (context_today() - datetime.timedelta(days=6)).strftime('%Y-%m-%d')),
                                 ('create_date_only', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>

                <filter string="Created: This Month"
                        name="created_this_month"
                        domain="[('create_date_only', '&gt;=', context_today().strftime('%Y-%m-01')),
                                 ('create_date_only', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>

                <filter string="Created: Last 30 Days"
                        name="created_last_30_days"
                        domain="[('create_date_only', '&gt;=', (context_today() - datetime.timedelta(days=29)).strftime('%Y-%m-%d')),
                                 ('create_date_only', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>

                <separator/>

                <filter string="Leads Created Today"
                        name="my_leads_today"
                        domain="[('create_date_only', '=', context_today())]"/>

                <filter string="Pending Leads Today"
                        name="pending_leads_today"
                        domain="[('create_date_only', '=', context_today()),
                                 ('current_status', '=', 'lead')]"/>

                <filter string="Unassigned"
                        name="unassigned"
                        domain="[('user_id', '=', False)]"/>

                <separator/>

                <filter string="Site Visits Today"
                        name="site_visits_today"
                    domain="['|',
                         ('site_visit_ids.scheduled_date', '=', context_today()),
                         ('child_inquiry_ids.site_visit_ids.scheduled_date', '=', context_today())
                        ]"
                    help="Visits scheduled today across inquiry and recommended inquiry chains"/>

                <filter string="Ops Sales Leads"
                        name="ops_sales_leads"
                        domain="[('is_ops_sale_lead', '=', True)]"/>

                <filter string="Ops Sales Leads (No BDE)"
                        name="ops_sales_leads_no_bde"
                        domain="[('is_ops_sale_lead', '=', True), ('bde_id', '=', False)]"/>

                <separator/>

                <filter string="Current Status" name="groupby_status" context="{'group_by': 'current_status'}"/>
                <filter string="RM"             name="groupby_user"   context="{'group_by': 'user_id'}"/>
                <filter string="BDE"            name="groupby_bde"    context="{'group_by': 'bde_id'}"/>

                <filter string="Property (All Associated)"
                        name="groupby_all_props"
                        context="{'group_by': 'all_associated_properties'}"/>

                <filter string="Main State"     name="groupby_state"  context="{'group_by': 'state'}"/>
                <filter string="Source"         name="groupby_source" context="{'group_by': 'source_id'}"/>
                <filter string="Creation Date"  name="groupby_date"   context="{'group_by': 'create_date_only'}"/>
            </search>
        </field>
    </record>

    <record id="view_new_portal_lead_list" model="ir.ui.view">
        <field name="name">leads.new.list</field>
        <field name="model">leads.new</field>
        <field name="arch" type="xml">
            <list string="New Portal Leads"
                    js_class="leads_new_list_controller"
                    decoration-success="(state=='assigned' and current_status=='lead')"
                    decoration-info="current_status != 'lead'"
                    decoration-danger="state=='new'">

                <field name="create_date"/>
                <field name="source_id" string="Source"/>
                <field name="name"/>
                <field name="phone"/>
                <button name="action_whatsapp_with_copy"
                    type="object"
                    icon="fa-whatsapp"
                    title="Chat on WhatsApp (and copy message)"
                    invisible="phone_whatsapp_url == False"/>
                <field name="property_base_id" string="Property"/>
                <field name="user_id"/>
                <field name="current_status"/>
                <field name="bde_id" optional="hide"/>
                <field name="interest_ids" widget="one2many"  optional="hide">
                    <list>
                        <field name="property_base_id" string="Property"/>
                        <field name="current_status"/>
                    </list>
                </field>
            </list>
        </field>
    </record>

    <record id="view_lead_property_interest_form" model="ir.ui.view">
        <field name="name">lead.property.interest.form</field>
        <field name="model">lead.property.interest</field>
        <field name="arch" type="xml">
            <form string="Recommended Property Status">
                <header>
                    <field name="current_status" widget="statusbar"
                           statusbar_visible="lead,details_shared_of_property,site_visit_scheduled,site_visit_done,requirement_closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="lead_id" readonly="1" force_save="1"/>
                            <field name="property_base_id" string="Property" force_save="1"/>
                        </group>
                        <group>
                            <field name="base_property_bhk" readonly="1"/>
                            <field name="base_property_location" readonly="1"/>
                        </group>
                    </group>

                    <group string="Update Status">
                        <field name="current_status"/>
                        <field name="site_visit_date"
                               invisible="current_status != 'site_visit_scheduled'"/>
                        <field name="feedback_general" placeholder="Select Appropriate Feedback" string="Feedback" invisible = "current_status == 'site_visit_done'"/>
                        <field name="feedback_site_visit_done" placeholder="Select appropriate feedback" string = "Feedback" invisible = "current_status != 'site_visit_done'"/>

                        <field name="remarks"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_new_portal_lead_form" model="ir.ui.view">
        <field name="name">leads.new.form</field>
        <field name="model">leads.new</field>
        <field name="arch" type="xml">
            <form string="Lead">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,assigned,failed"
                           groups="leads.group_lead_score_manager"/>

                    <field name="current_status" widget="statusbar"
                              statusbar_visible="lead,details_shared_of_property,requirement_closed"
                           groups="leads.group_lead_score_rm"/>

                    <button name="action_open_add_site_visit_wizard"
                            type="object"
                            string="Schedule a Visit"
                            class="btn-primary"
                            groups="leads.group_lead_score_rm"/>

                        <button name="action_open_update_latest_visit_wizard"
                            type="object"
                            string="Update Latest Visit"
                            class="btn-secondary"
                            invisible="not latest_site_visit_id"
                            groups="leads.group_lead_score_rm"/>

                    <button name="action_open_recommend_property_wizard"
                            type="object"
                            string="Recommend Property"
                            class="btn-secondary"
                            invisible="inquiry_type != 'primary'"
                            groups="leads.group_lead_score_rm"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="inquiry_type != 'primary'">
                        Primary Inquiry
                    </div>
                    <div class="alert alert-warning" role="status" invisible="inquiry_type != 'recommended'">
                        Recommended Inquiry
                    </div>
                    <group>
                        <group>
                            <field name="name"/>

                            <label for="phone"/>
                            <div class="d-flex align-items-center">
                                <field name="phone" nolabel="1" class="w-auto"/>
                                <button name="action_whatsapp_with_copy"
                                        type="object"
                                        icon="fa-whatsapp"
                                        title="Chat on WhatsApp (and copy message)"
                                        class="btn-link ms-2"
                                        invisible="phone_whatsapp_url == False"/>
                            </div>

                            <field name="email"/>
                        </group>
                        <group>
                            <field name="source_id" required="1"/>
                            <field name="is_portal_source" invisible="1"/>
                            <field name="portal_property_id" invisible="not is_portal_source"/>
                            <field name="inquiry_type" readonly="1"/>
                            <field name="parent_inquiry_id" readonly="1" invisible="inquiry_type != 'recommended'"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Primary Inquiry" name="primary_inquiry">
                            <group>
                                <group>
                                    <field name="user_id"/>
                                    <field name="property_base_id" string="Property"/>
                                    <field name="base_property_tag" string="Property Tag"/>
                                    <field name="current_status"/>
                                    <field name="latest_site_visit_id" readonly="1"/>
                                    <div class="o_form_label text-muted">Use Schedule a Visit and Site Visit History for all visit updates.</div>
                                    <field name="remarks"/>
                                </group>
                                <group>
                                    <field name="base_property_location" string="Location"/>
                                    <field name="base_property_link" string="Property Link" widget="url"/>
                                    <field name="base_property_bhk" string="BHK"/>
                                    <field name="base_property_city" string="City"/>
                                    <field name="base_property_owner_name" string="Owner"/>
                                    <field name="is_ops_sale_lead" widget="boolean"/>
                                    <field name="bde_allowed_ids" invisible="1"/>
                                    <field name="bde_id"
                                           invisible="not is_ops_sale_lead"
                                           required="is_ops_sale_lead"
                                           domain="[('id', 'in', bde_allowed_ids)]"/>
                                </group>
                            </group>
                        </page>

                        <page string="Recommended Inquiries" name="recommended_inquiries" invisible="inquiry_type != 'primary'">
                            <field name="child_inquiry_ids" nolabel="1">
                                <list>
                                    <field name="name" string="Lead Name"/>
                                    <field name="property_base_id" string="Property"/>
                                    <field name="user_id" string="RM"/>
                                    <field name="current_status"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Visit Timeline" name="site_visit_history">
                            <group>
                                <field name="latest_site_visit_id" readonly="1"/>
                                <button name="action_view_site_visits"
                                        type="object"
                                        string="Open Inquiry Visit List"
                                        class="btn-secondary"/>
                                <button name="action_view_all_phone_site_visits"
                                        type="object"
                                        string="Open Overall Visit List"
                                        class="btn-secondary"
                                        invisible="not phone"/>
                            </group>
                            <group>
                                <div class="o_form_label text-muted">Inquiry Timeline shows only this inquiry. Overall Lead Timeline includes all visits for the same lead phone across all inquiries and RMs.</div>
                            </group>
                            <group string="Inquiry Timeline (This Inquiry Only)">
                            <field name="inquiry_timeline_html" widget="html" sanitize="0" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Overall Lead Timeline (All Inquiries)">
                                <field name="overall_timeline_html" widget="html" sanitize="0" readonly="1" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

        <record id="action_new_portal_lead" model="ir.actions.act_window">
            <field name="name">Leads</field>
                <field name="res_model">leads.new</field>
                <field name="view_mode">list,form</field>
                <field name="help" type="html">
                    <p class="o_view_nocontent_smiling_face">
                        No leads yet.
                    </p>
                </field>
        </record>

        <menuitem id="menu_new_portal_lead"
                            name="Leads"
                            parent="leads.menu_daily_operations"
                            action="action_new_portal_lead"
                            sequence="5"
                            groups="leads.group_lead_score_rm"/>
</odoo>
