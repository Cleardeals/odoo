<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 
        KANBAN VIEW
        - Now groups by the new 'state' field
        - Includes 'city'
        -->
        <record id="view_imported_lead_kanban" model="ir.ui.view">
            <field name="name">imported.lead.kanban</field>
            <field name="model">imported.lead</field>
            <field name="arch" type="xml">
                <!-- Groups by the new 'state' field for a proper pipeline view -->
                <kanban default_group_by="state" class="o_kanban_mobile">
                    <field name="partner_name"/>
                    <field name="phone"/>
                    <field name="source"/>
                    <field name="rm_user_id"/>
                    <field name="city"/>
                    <field name="state"/>
                    <templates>
                        <!-- This is the correct 'kanban-box' template -->
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_imported_lead_kanban">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="partner_name"/>
                                    </div>
                                    <div class="o_kanban_tags_section">
                                        <span class="oe_kanban_list_many2one">
                                            <i class="fa fa-phone" role="img" aria-label="Phone"/>
                                            <field name="phone"/>
                                        </span>
                                    </div>
                                    <div class="o_kanban_tags_section">
                                        <span class="oe_kanban_list_many2one">
                                            <i class="fa fa-map-marker" role="img" aria-label="Tag"/>
                                            <field name="property_tag"/>
                                        </span>
                                    </div>
                                    <div class="o_kanban_tags_section">
                                        <field name="source" widget="badge"/>
                                        <!-- Added City -->
                                        <field name="city"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="rm_user_id" widget="many2one_avatar_user"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- 
        LIST/TREE VIEW 
        - Added 'city', 'state', and 'price_range'
        -->
        <record id="view_imported_lead_tree" model="ir.ui.view">
            <field name="name">imported.lead.list</field>
            <field name="model">imported.lead</field>
            <field name="arch" type="xml">
                <list string="Imported Leads" default_order="create_date desc">
                    <field name="name"/>
                    <!-- Added State -->
                    <field name="state"/>
                    <field name="partner_name"/>
                    <field name="phone"/>
                    <!-- Added City -->
                    <field name="city"/>
                    <field name="source"/>
                    <field name="property_tag"/>
                    <!-- Added Price Range -->
                    <field name="price_range"/>
                    <field name="rm_user_id"/>
                    <field name="create_date" string="Imported On"/>
                </list>
            </field>
        </record>

        <!-- 
        FORM VIEW 
        - Added 'state' status bar
        - Added 'city' and 'price_range'
        -->
        <record id="view_imported_lead_form" model="ir.ui.view">
            <field name="name">imported.lead.form</field>
            <field name="model">imported.lead</field>
            <field name="arch" type="xml">
                <form string="Imported Lead">
                    <header>
                        <!-- Added Status Bar -->
                        <field name="state" widget="statusbar" statusbar_visible="new,contacted,busy"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Lead Title..."/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_name" placeholder="Contact's Name"/>
                                <field name="phone"/>
                                <!-- Added City -->
                                <field name="city"/>
                                <field name="rm_user_id"/>
                            </group>
                            <group>
                                <field name="source"/>
                                <field name="property_tag"/>
                                <!-- Added Price Range -->
                                <field name="price_range"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Property Details">
                                <group>
                                    <field name="address" placeholder="Property Address from CSV..."/>
                                </group>
                            </page>
                            <page string="Other Info">
                                <group>
                                    <field name="description" placeholder="Full CSV row data..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Main Action Window -->
        <record id="action_imported_leads" model="ir.actions.act_window">
            <field name="name">Imported CSV Leads</field>
            <field name="res_model">imported.lead</field>
            <!-- Changed view_mode to include tree -->
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No leads imported yet!
                </p><p>
                    Use the 'Import Leads (CSV)' menu to add new leads.
                </p>
            </field>
        </record>

    </data>
</odoo>

