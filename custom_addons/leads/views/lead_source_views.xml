<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_source_category_list" model="ir.ui.view">
        <field name="name">lead.source.category.list</field>
        <field name="model">lead.source.category</field>
        <field name="arch" type="xml">
            <list string="Source Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="source_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lead_source_category_form" model="ir.ui.view">
        <field name="name">lead.source.category.form</field>
        <field name="model">lead.source.category</field>
        <field name="arch" type="xml">
            <form string="Source Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="source_type"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lead_source_list" model="ir.ui.view">
        <field name="name">lead.source.list</field>
        <field name="model">lead.source</field>
        <field name="arch" type="xml">
            <list string="Lead Sources" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Source Name"/>
                <field name="category_id" string="Category"/>
                <field name="source_type" readonly="1"/>
                <field name="portal_code" optional="hide"/>
                <field name="default_rm_user_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lead_source_search" model="ir.ui.view">
        <field name="name">lead.source.search</field>
        <field name="model">lead.source</field>
        <field name="arch" type="xml">
            <search string="Search Lead Sources">
                <field name="name"/>
                <field name="category_id"/>
                <field name="portal_code"/>
                <field name="default_rm_user_id"/>

                <filter name="portal_sources" string="Portal Sources" domain="[('source_type', '=', 'portal')]"/>
                <filter name="manual_sources" string="Manual Sources" domain="[('source_type', '=', 'manual')]"/>
                <filter name="missing_fallback_rm" string="Needs Fallback RM" domain="[('source_type', '=', 'portal'), ('default_rm_user_id', '=', False)]"/>

                <separator/>
                <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
                <filter name="group_by_fallback_rm" string="Fallback RM" context="{'group_by': 'default_rm_user_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_lead_source_form" model="ir.ui.view">
        <field name="name">lead.source.form</field>
        <field name="model">lead.source</field>
        <field name="arch" type="xml">
            <form string="Lead Source">
                <sheet>
                    <div class="alert alert-info" role="status" invisible="source_type != 'portal'">
                        Set a Fallback RM to make sure portal leads are still assigned when listing matching fails.
                    </div>
                    <group>
                        <group string="Source Details">
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="source_type" readonly="1"/>
                        </group>
                        <group string="Routing Settings">
                            <field name="portal_code" invisible="source_type != 'portal'"/>
                            <field name="default_rm_user_id"
                                   invisible="source_type != 'portal'"
                                   required="source_type == 'portal'"
                                   domain="[('share', '=', False)]"
                                   options="{'no_open': True}"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lead_source" model="ir.actions.act_window">
        <field name="name">Lead Sources</field>
        <field name="res_model">lead.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start by adding a lead source.
            </p>
            <p>
                For portal sources, set a Fallback RM so unmatched leads are routed to the right user.
            </p>
        </field>
    </record>

    <record id="action_lead_source_category" model="ir.actions.act_window">
        <field name="name">Source Categories</field>
        <field name="res_model">lead.source.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="lead_source_config_root"
              name="Settings"
              parent="leads.lead_score_menu_main"
              sequence="90"
              groups="leads.group_lead_score_manager"/>

    <menuitem id="menu_lead_source"
              name="Sources"
              parent="lead_source_config_root"
              action="action_lead_source"
              sequence="10"
              groups="leads.group_lead_score_manager"/>

    <menuitem id="menu_lead_source_category"
              name="Source Categories"
              parent="lead_source_config_root"
              action="action_lead_source_category"
              sequence="20"
              groups="leads.group_lead_score_manager"/>
</odoo>
