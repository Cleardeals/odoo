<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_renewal_template_stats_list" model="ir.ui.view">
        <field name="name">renewal.template.stats.list</field>
        <field name="model">renewal.template.stats</field>
        <field name="arch" type="xml">
            <list string="Template Performance" create="false" edit="false">
                <field name="date" options="{'numeric': true}"/>
                <field name="template_name"/>
                <field name="total_sent" sum="Total Sent"/>
                <field name="total_delivered" sum="Total Delivered"/>
                <field name="total_read" sum="Total Read"/>
                <field name="total_failed" sum="Total Failed"/>
                <field name="delivery_rate" widget="progressbar"/>
                <field name="read_rate" widget="progressbar"/>
                
                <button name="action_view_owners" 
                        type="object" 
                        string="View Owners" 
                        icon="fa-users" 
                        class="btn-secondary"/>
            </list>
        </field>
    </record>

    <record id="view_renewal_template_stats_search" model="ir.ui.view">
        <field name="name">renewal.template.stats.search</field>
        <field name="model">renewal.template.stats</field>
        <field name="arch" type="xml">
            <search string="Search Template Stats">
                <field name="template_name"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date', '=', context_today())]"/>
                <filter string="This Week" name="this_week" domain="[('date', '&gt;=', (context_today() - relativedelta(weeks=1, weekday=0)).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + relativedelta(weeks=0, weekday=6)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                
                <separator/>
                <filter string="Template" name="group_by_template" context="{'group_by': 'template_name'}"/>
                <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>
    
    <record id="view_renewal_template_stats_pivot" model="ir.ui.view">
        <field name="name">renewal.template.stats.pivot</field>
        <field name="model">renewal.template.stats</field>
        <field name="arch" type="xml">
            <pivot string="Template Performance Pivot">
                <field name="template_name" type="row"/>
                <field name="delivery_rate" type="measure"/>
                <field name="read_rate" type="measure"/>
            </pivot>
        </field>
    </record>
    
    <record id="view_renewal_template_stats_graph" model="ir.ui.view">
        <field name="name">renewal.template.stats.graph</field>
        <field name="model">renewal.template.stats</field>
        <field name="arch" type="xml">
            <graph string="Template Performance Graph" type="bar">
                <field name="template_name" type="col"/>
                <field name="delivery_rate" type="measure"/>
                <field name="read_rate" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_renewal_template_stats" model="ir.actions.act_window">
        <field name="name">Template Performance</field>
        <field name="res_model">renewal.template.stats</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_renewal_template_stats_search"/>
        <field name="context">
            {'search_default_group_by_template': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No template statistics found.
            </p><p>
                Data is synced from BigQuery daily.
            </p>
        </field>
    </record>

</odoo>