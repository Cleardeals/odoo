<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_scoring_template_stats_list" model="ir.ui.view">
        <field name="name">lead.scoring.template.stats.list</field>
        <field name="model">lead.scoring.template.stats</field>
        <field name="arch" type="xml">
            <list string="Template Performance" create="false" edit="false">
                <field name="date" options="{'numeric': true}"/>
                <field name="template_name"/>
                <field name="total_sent" sum="Total Sent"/>
                <field name="total_delivered" sum="Total Delivered"/>
                <field name="total_read" sum="Total Read"/>
                <field name="total_clicked" sum="Total Clicked"/>
                <field name="total_failed" sum="Total Failed"/>
                <field name="delivery_rate" widget="progressbar"/>
                <field name="read_rate" widget="progressbar"/>
                <field name="click_rate" widget="progressbar"/>
            </list>
        </field>
    </record>

    <record id="view_lead_scoring_template_stats_search" model="ir.ui.view">
        <field name="name">lead.scoring.template.stats.search</field>
        <field name="model">lead.scoring.template.stats</field>
        <field name="arch" type="xml">
            <search>
                <field name="template_name"/>
                <filter string="Today" name="today" domain="[('date', '=', context_today())]"/>
                
                <separator/>
                <filter string="Template" name="group_by_template" context="{'group_by': 'template_name'}"/>
                <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <record id="view_lead_scoring_template_stats_pivot" model="ir.ui.view">
        <field name="name">lead.scoring.template.stats.pivot</field>
        <field name="model">lead.scoring.template.stats</field>
        <field name="arch" type="xml">
            <pivot string="Template Performance Pivot">
                <field name="template_name" type="row"/>
                <field name="delivery_rate" type="measure"/>
                <field name="read_rate" type="measure"/>
                <field name="click_rate" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_lead_scoring_template_stats_graph" model="ir.ui.view">
        <field name="name">lead.scoring.template.stats.graph</field>
        <field name="model">lead.scoring.template.stats</field>
        <field name="arch" type="xml">
            <graph string="Template Performance Graph" type="bar">
                <field name="template_name" type="col"/>
                <field name="delivery_rate" type="measure"/>
                <field name="read_rate" type="measure"/>
                <field name="click_rate" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_lead_scoring_template_stats" model="ir.actions.act_window">
        <field name="name">Lead Scoring Templates</field>
        <field name="res_model">lead.scoring.template.stats</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{'search_default_group_by_template': 1}</field>
    </record>
</odoo>