<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_assignment_stat_list" model="ir.ui.view">
        <field name="name">property.assignment.stat.list</field>
        <field name="model">property.assignment.stat</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_tag"/>
                <field name="total_assignments"/>
                <field name="last_eligible_date"/>
            </list>
        </field>
    </record>

    <record id="view_property_assignment_stat_search" model="ir.ui.view">
        <field name="name">property.assignment.stat.search</field>
        <field name="model">property.assignment.stat</field>
        <field name="arch" type="xml">
            <search string="Search Property Stats">
                <field name="property_tag"/>
                <separator/>
                <filter string="Unassigned" name="unassigned" domain="[('total_assignments', '=', 0)]"/>
                <filter string="Assigned" name="assigned" domain="[('total_assignments', '&gt;', 0)]"/>
                <separator/>
                <filter string="Eligible This Month" name="eligible_month" domain="[('last_eligible_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Eligible This Quarter" name="eligible_quarter" domain="[('last_eligible_date', '&gt;=', (context_today() - relativedelta(months=(context_today().month-1)%3, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Last Eligible Month" name="group_by_eligible_month" context="{'group_by': 'last_eligible_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_unassigned_properties_dashboard" model="ir.actions.act_window">
        <field name="name">Unassigned Properties</field>
        <field name="res_model">property.assignment.stat</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_property_assignment_stat_search"/>
        <field name="context">{'search_default_unassigned': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No unassigned properties found.
            </p><p>
                This list shows all properties that were eligible for lead routing
                but have not been assigned to any leads.
            </p>
        </field>
    </record>

</odoo>