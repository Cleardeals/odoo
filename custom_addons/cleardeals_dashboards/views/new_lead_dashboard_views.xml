<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dashboard_list" model="ir.ui.view">
        <field name="name">leads.new.dashboard.list</field>
        <field name="model">leads.new.dashboard</field>
        <field name="arch" type="xml">
            <list string="New Leads Dashboard" create="false" edit="false" default_order="create_date desc">
                <field name="lead_create_date_only" optional="show"/>
                <field name="lead_name"/>
                <field name="lead_phone" optional="show"/>
                <field name="assigned_rm" widget="many2one_avatar_user"/>
                <field name="current_status" widget="badge"
                       decoration-success="current_status == 'contacted'"
                       decoration-info="current_status == 'new'"
                       decoration-danger="current_status == 'failed'"/>
                
                <field name="is_unassigned" column_invisible="True"/>
                <field name="is_contacted" widget="boolean_toggle"/>
                <field name="is_delivered" widget="boolean_toggle"/>
                <field name="is_read" widget="boolean_toggle"/>
                <field name="has_replied" widget="boolean_toggle"/>
                <field name="last_event_date" widget="datetime"/>

                <field name="cnt_initial_msg" optional="hide"/>
                <field name="cnt_reply_plan_visit" optional="show"/>
                <field name="cnt_reply_similar" optional="show"/>
                <field name="cnt_reply_call_now" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dashboard_pivot" model="ir.ui.view">
        <field name="name">leads.new.dashboard.pivot</field>
        <field name="model">leads.new.dashboard</field>
        <field name="arch" type="xml">
            <pivot string="New Leads Analysis" sample="1">
                <field name="lead_create_date_only" type="row" interval="day"/>
                <field name="assigned_rm" type="col"/>
                <field name="cnt_reply_plan_visit" type="measure"/>
                <field name="cnt_reply_call_now" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dashboard_graph" model="ir.ui.view">
        <field name="name">leads.new.dashboard.graph</field>
        <field name="model">leads.new.dashboard</field>
        <field name="arch" type="xml">
            <graph string="New Leads Trends" type="line" sample="1">
                <field name="lead_create_date_only" interval="day"/>
                <field name="assigned_rm"/>
                </graph>
        </field>
    </record>

    <record id="view_dashboard_search" model="ir.ui.view">
        <field name="name">leads.new.dashboard.search</field>
        <field name="model">leads.new.dashboard</field>
        <field name="arch" type="xml">
            <search string="Search Dashboard">
                <field name="lead_name"/>
                <field name="lead_phone"/>
                <field name="assigned_rm"/>
                
                <separator/>
                <filter string="Unassigned" name="unassigned" domain="[('is_unassigned', '=', True)]"/>
                <filter string="Contacted" name="contacted" domain="[('is_contacted', '=', True)]"/>
                <filter string="Replied" name="replied" domain="[('has_replied', '=', True)]"/>
                
                <separator/>
                <filter string="Creation Date: Today" name="today" domain="[('lead_create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('lead_create_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Creation Date: Last 7 Days" name="last_7_days" domain="[('lead_create_date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>

                <separator/>
                <filter string="Assigned RM" name="group_rm" context="{'group_by': 'assigned_rm'}"/>
                <filter string="Creation Date" name="group_date" context="{'group_by': 'lead_create_date_only'}"/>
                <filter string="Status" name="group_status" context="{'group_by': 'current_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_new_leads_dashboard" model="ir.actions.act_window">
        <field name="name">New Leads Dashboard</field>
        <field name="res_model">leads.new.dashboard</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_dashboard_search"/>
        <field name="context">{
            'search_default_today': 1,
            'pivot_measures': ['__count']
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No new leads found for the selected criteria.
            </p>
        </field>
    </record>

</odoo>