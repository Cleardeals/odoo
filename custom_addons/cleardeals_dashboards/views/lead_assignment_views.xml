<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_active_lead_assignment_list" model="ir.ui.view">
        <field name="name">active.lead.assignment.list</field>
        <field name="model">active.lead.assignment</field>
        <field name="arch" type="xml">
            <list string="Lead Assignments" create="false" edit="false"> 
                <field name="lead_name"/>
                <field name="lead_phone"/>
                <field name="assigned_property_tag"/>
                <field name="original_property_tag"/>
                <field name="assignment_date" options="{'numeric': true}"/>
            </list>
        </field>
    </record>

    <record id="view_active_lead_assignment_search" model="ir.ui.view">
        <field name="name">active.lead.assignment.search</field>
        <field name="model">active.lead.assignment</field>
        <field name="arch" type="xml">
            <search string="Search Assignments">
                <field name="lead_name"/>
                <field name="lead_phone"/>
                <field name="assigned_property_tag"/>
                <field name="original_property_tag"/>
                <separator/>
                <filter string="Today" name="today" domain="[('assignment_date', '=', context_today())]"/>
                <filter string="This Week" name="this_week" domain="[('assignment_date', '&gt;=', (context_today() - relativedelta(weeks=1, weekday=0)).strftime('%Y-%m-%d')), ('assignment_date', '&lt;=', (context_today() + relativedelta(weeks=0, weekday=6)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('assignment_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')), ('assignment_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Quarter" name="this_quarter" domain="[('assignment_date', '&gt;=', (context_today() - relativedelta(months=(context_today().month-1)%3, day=1)).strftime('%Y-%m-%d')), ('assignment_date', '&lt;=', (context_today() + relativedelta(months=(2-((context_today().month-1)%3)), day=31)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Year" name="this_year" domain="[('assignment_date', '&gt;=', (context_today() - relativedelta(month=1, day=1)).strftime('%Y-%m-%d')), ('assignment_date', '&lt;=', (context_today() + relativedelta(month=12, day=31)).strftime('%Y-%m-%d'))]"/>
                
                <separator/>
                <filter string="Lead Name" name="group_by_lead" context="{'group_by': 'lead_name'}"/>
                <filter string="Assigned Property" name="group_by_assigned_property" context="{'group_by': 'assigned_property_tag'}"/>
                <filter string="Original Property" name="group_by_original_property" context="{'group_by': 'original_property_tag'}"/>
                <separator/>
                <filter string="Assignment Date: Day" name="group_by_assignment_date_day" context="{'group_by': 'assignment_date:day'}"/>
                <filter string="Assignment Date: Month" name="group_by_assignment_date_month" context="{'group_by': 'assignment_date:month'}"/>
                <filter string="Assignment Date: Year" name="group_by_assignment_date_year" context="{'group_by': 'assignment_date:year'}"/>
            </search>
        </field>      
    </record>

    <record id="view_active_lead_assignment_graph" model="ir.ui.view">
        <field name="name">active.lead.assignment.graph</field>
        <field name="model">active.lead.assignment</field>
        <field name="arch" type="xml">
            <graph string="Lead Assignments Dashboard" type="bar">
                <field name="assigned_property_tag" type="row"/>
                <field name="assignment_date" type="col"/>
            </graph>
        </field>
    </record>

    <record id="view_active_lead_assignment_pivot" model="ir.ui.view">
        <field name="name">active.lead.assignment.pivot</field>
        <field name="model">active.lead.assignment</field>
        <field name="arch" type="xml">
            <pivot string="Lead Assignments Pivot">
                <field name="assigned_property_tag" type="row"/>
                <field name="assignment_date" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_active_lead_assignment_dashboard" model="ir.actions.act_window">
        <field name="name">Lead Routing Dashboard</field>
        <field name="res_model">active.lead.assignment</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_active_lead_assignment_search"/>
        <field name="context">
            {'search_default_group_by_assigned_property': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No lead assignments found.
            </p><p>
                This dashboard tracks leads assigned to new properties based on their feedback.
                Data is synced from BigQuery daily.
            </p>
        </field>
    </record>

</odoo>