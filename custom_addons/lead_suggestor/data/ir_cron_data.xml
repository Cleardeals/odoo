<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- 
          Cron Job to sync the master list of properties and assign RMs.
          Runs once a day.
        -->
        <record id="cron_sync_rm_properties" model="ir.cron">
            <field name="name">Lead Suggestor: Sync RM Property Inventory</field>
            <!-- Note: model_id ref is now model_property_inventory -->
            <field name="model_id" ref="model_property_inventory"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_properties()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
        
        <!-- 
          Cron Job to sync new lead suggestions from BQ.
          Runs once a day, 1 hour after the property sync.
        -->
        <record id="cron_sync_lead_suggestions" model="ir.cron">
            <field name="name">Lead Suggestor: Sync Lead Suggestions</field>
            <field name="model_id" ref="model_property_lead_suggestion"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_suggestions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>

    </data>
</odoo>
