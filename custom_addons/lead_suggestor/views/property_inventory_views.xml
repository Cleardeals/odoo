<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Kanban View - Simplified -->
    <record id="view_property_inventory_kanban" model="ir.ui.view">
        <field name="name">property.inventory.kanban</field>
        <field name="model">property.inventory</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false">
                <!-- Fields needed for display/logic -->
                <field name="property_tag"/>
                <field name="rm_user_id"/>
                <field name="suggestion_count"/>
                <field name="new_suggestion_count"/>
                <field name="service_expiry_date"/>
                <templates>
                    <t t-name="kanban-box">
                        
                        <div t-attf-class="oe_kanban_global_click #{!selection_mode ? '' : 'o_kanban_selected'} #{record.service_expiry_date.raw_value and record.service_expiry_date.raw_value &lt; (new Date()).toISOString().substring(0, 10) ? 'oe_kanban_card_red' : ''}">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="property_tag"/></strong>
                                <div class="text-muted o_kanban_record_subtitle">
                                    <span t-if="record.rm_user_id.value">
                                        <i class="fa fa-user ml-1" aria-label="RM"/>
                                        <t t-esc="record.rm_user_id.value"/>
                                    </span>
                                </div>
                            </div>
                            <!-- Counters -->
                            <div class="o_kanban_footer">
                                <div class="o_kanban_footer_left">
                                    <span class="text-muted">
                                        <i class="fa fa-users" aria-label="Total Suggestions"/>
                                        <t t-esc="record.suggestion_count.value"/> Total
                                    </span>
                                </div>
                                <div class="o_kanban_footer_right">
                                    <span t-if="record.new_suggestion_count.value > 0"
                                          class="badge badge-danger"
                                          title="New Suggestions">
                                        <i class="fa fa-star" aria-label="New"/>
                                        <t t-esc="record.new_suggestion_count.value"/> New
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 2. Form View - Updated fields, added chatter -->
    <record id="view_property_inventory_form" model="ir.ui.view">
        <field name="name">property.inventory.form</field>
        <field name="model">property.inventory</field>
        <field name="arch" type="xml">
            <!-- Set editable="false" as data comes from BQ -->
            <form string="Property Details" create="false" edit="false">
                 <sheet>
                    <div class="oe_title">
                        <h1><field name="property_tag" readonly="1"/></h1>
                    </div>
                    <!-- Property Details Header -->
                    <group>
                        <group>
                            <field name="rm_user_id" readonly="1"/>
                            <field name="owner_name" readonly="1"/>
                            <field name="owner_phone" readonly="1"/>
                        </group>
                        <group>

                            <field name="service_expiry_date_str" readonly="1" string="Service Expiry Date"/> 
                        </group>
                    </group>
                    <group class="oe_subtotal_footer oe_right" colspan="2" name="suggestion_summary">
                        <field name="suggestion_count" nolabel="1" class="oe_subtotal_footer_separator" string="Total Suggestions"/>
                        <field name="new_suggestion_count" nolabel="1" string="New Suggestions"/>
                    </group>
                    <div class="clearfix"/>

                    <notebook>
                        <page string="Similar Leads" name="suggestions">
                            <field name="suggestion_ids" nolabel="1">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'converted'"
                                           decoration-warning="status in ('contacted', 'interested')"
                                           decoration-danger="status == 'not_interested'"
                                           decoration-info="status == 'new'"/>
                                    <field name="generation_date" readonly="1"/>
                                    <field name="lead_name" readonly="1"/>
                                    <field name="suggested_lead_phone" readonly="1"/>
                                    <field name="contact_type" string="Lead Status" readonly="1"/>
                                    <field name="original_property_tag" readonly="1" string="Liked"/>
                                    <field name="original_property_similarity" readonly="1" string="Match (%)" widget="progressbar"/>
                                    <field name="rm_feedback"/>
                                    <button name="action_log_feedback" type="object"
                                        string="Feedback" icon="fa-pencil-square-o"
                                        class="btn-sm btn-primary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                 </sheet>
            </form>
        </field>
    </record>

    <!-- 3. Search View - Updated fields -->
    <record id="view_property_inventory_search" model="ir.ui.view">
        <field name="name">property.inventory.search</field>
        <field name="model">property.inventory</field>
        <field name="arch" type="xml">
            <search>
                <field name="property_tag" string="Property Tag"/>
                <field name="rm_user_id" string="Assigned RM"/>
                <field name="owner_name" string="Owner Name"/>
                <field name="owner_phone" string="Owner Phone"/>
                <separator/>
                <filter name="filter_new_suggestions"
                        string="With New Suggestions"
                        domain="[('new_suggestion_count', '>', 0)]"/>
                <filter name="filter_my_properties"
                        string="My Properties"
                        domain="[('rm_user_id', '=', uid)]" help="Show only properties assigned to you"/>
                 <filter name="filter_active"
                        string="Active Only"
                        domain="[('is_active', '=', True)]" help="Show only properties marked as Active"/>
                 <filter name="filter_inactive"
                        string="Inactive/Expired"
                        domain="[('is_active', '=', False)]" help="Show only properties marked as Inactive"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Assigned RM" name="group_by_rm" context="{'group_by': 'rm_user_id'}"/>
                    <filter string="Is Active" name="group_by_active" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 4. Window Action (FOR RM USER) - Updated context -->
    <record id="action_property_inventory_rm" model="ir.actions.act_window">
        <field name="name">My Property Suggestions</field>
        <field name="res_model">property.inventory</field>
        <field name="view_mode">kanban,form</field>
        <field name="search_view_id" ref="view_property_inventory_search"/>
        <!-- Domain still applies -->
        <field name="domain">[('rm_user_id', '=', uid), ('is_active', '=', True)]</field> <!-- Also filter for active -->
        <!-- Context defaults search filters -->
        <field name="context">{
            'search_default_filter_active': 1,
            'search_default_filter_my_properties': 1,
            'search_default_filter_new_suggestions': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active properties with new suggestions assigned to you.
            </p><p>
                Clear the default filters ('Active Only', 'With New Suggestions') to see all properties assigned to you.
            </p>
        </field>
    </record>

    <!-- 5. Window Action (FOR MANAGER) - Updated context -->
    <record id="action_property_inventory_manager" model="ir.actions.act_window">
        <field name="name">All Property Suggestions</field>
        <field name="res_model">property.inventory</field>
        <field name="view_mode">kanban,form</field>
        <field name="search_view_id" ref="view_property_inventory_search"/>
        <field name="domain">[]</field> 
        <!-- Context defaults search filters/grouping -->
        <field name="context">{
            'search_default_filter_active': 1,
            'search_default_group_by_rm': 1,
            'search_default_filter_new_suggestions': 1
        }</field>
        <field name="help" type="html">
             <p class="o_view_nocontent_smiling_face">
                 No active properties with new suggestions found.
             </p><p>
                 Clear filters to see all properties. Use 'Group By' to organize the view.
             </p>
        </field>
    </record>

</odoo>

