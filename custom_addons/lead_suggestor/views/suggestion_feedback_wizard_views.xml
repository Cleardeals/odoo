<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_suggestion_feedback_wizard_form" model="ir.ui.view">
        <field name="name">suggestion.feedback.wizard.form</field>
        <field name="model">suggestion.feedback.wizard</field>
        <field name="arch" type="xml">
            <form string="Log Feedback">
                <group>
                    <field name="suggestion_id" invisible="1"/>
                    <field name="status" widget="radio"/>
                    <field name="rm_feedback" placeholder="Lead was interested in..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
