<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_deal_package_list" model="ir.ui.view">
            <field name="name">deal.package.list</field>
            <field name="model">deal.package</field>
            <field name="arch" type="xml">
                <list string="Deal Packages">
                    <field name="name"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_deal_package_form" model="ir.ui.view">
            <field name="name">deal.package.form</field>
            <field name="model">deal.package</field>
            <field name="arch" type="xml">
                <form string="Deal Package">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="is_active"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_deal_package_search" model="ir.ui.view">
            <field name="name">deal.package.search</field>
            <field name="model">deal.package</field>
            <field name="arch" type="xml">
                <search string="Search Deal Packages">
                    <field name="name" string="Package Name"/>
                    <filter name="filter_active" string="Active" domain="[('is_active', '=', True)]"/>
                    <filter name="filter_archived" string="Archived" domain="[('is_active', '=', False)]"/>
                </search>
            </field>
        </record>         

        <record id="action_deal_package" model="ir.actions.act_window">
            <field name="name">Deal Packages</field>
            <field name="res_model">deal.package</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_deal_package_search"/>
            <field name="context">{'search_default_filter_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No deal packages found.
                </p>
                <p>
                    Create packages with amount and currency so they can be used consistently across deal records.
                </p>
            </field>
        </record>

        <menuitem id="menu_deal_package"
                  name="Deal Packages"
                  action="action_deal_package"
                  sequence="20"/>
    </data>
</odoo>