<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wa_communication.WaInbox">
        <div t-att-class="'wa-inbox' + (state.activeConvId ? ' wa-inbox--chat-open' : '')">

            <!-- ── Top bar ─────────────────────────────────────────────────── -->
            <div class="wa-inbox__topbar">
                <div class="wa-inbox__topbar-left">
                    <span class="wa-inbox__title">
                        <i class="fa fa-whatsapp" aria-hidden="true"/> Conversation Inbox
                    </span>
                </div>
                <div class="wa-inbox__date-tabs">
                    <t t-foreach="dateRanges" t-as="dr" t-key="dr.key">
                        <button
                            t-attf-class="wa-inbox__date-tab {{ state.dateRange === dr.key ? 'wa-inbox__date-tab--active' : '' }}"
                            t-on-click="() => this.setDateRange(dr.key)">
                            <t t-esc="dr.label"/>
                        </button>
                    </t>
                </div>
            </div>

            <!-- ── Two-pane body: conversation list + chat ─────────────────── -->
            <div class="wa-inbox__body">

                <!-- ════ Pane 1: conversation list ════ -->
                <div class="wa-inbox__list-pane">

                    <div class="wa-inbox__list-controls">
                        <div class="wa-inbox__search">
                            <i class="fa fa-search" aria-hidden="true"/>
                            <input type="text"
                                   class="wa-inbox__search-input"
                                   placeholder="Search phone / lead..."
                                   t-on-input="onSearchInput"/>
                        </div>

                        <!-- Status segmented control with live counts -->
                        <div class="wa-inbox__segments">
                            <t t-foreach="statusSegments" t-as="seg" t-key="seg.key">
                                <button
                                    t-attf-class="wa-inbox__segment {{ state.statusFilter === seg.key ? 'wa-inbox__segment--active' : '' }}"
                                    t-on-click="() => this.setStatus(seg.key)">
                                    <span t-esc="seg.label"/>
                                    <span class="wa-inbox__segment-count" t-esc="statusCounts[seg.key]"/>
                                </button>
                            </t>
                        </div>

                        <!-- Sort + count -->
                        <div class="wa-inbox__list-subhead">
                            <label class="wa-inbox__sort">
                                <i class="fa fa-sort-amount-desc" aria-hidden="true"/>
                                <select class="wa-inbox__sort-select"
                                        t-on-change="(e) => this.setSort(e.target.value)">
                                    <t t-foreach="sortOptions" t-as="so" t-key="so.key">
                                        <option t-att-value="so.key"
                                                t-att-selected="state.sortKey === so.key"
                                                t-esc="so.label"/>
                                    </t>
                                </select>
                            </label>
                            <span class="wa-inbox__count"><t t-esc="state.totalCount"/> chats</span>
                        </div>

                        <!-- RM filter pills -->
                        <t t-if="state.counts.assigned_rms and state.counts.assigned_rms.length">
                            <div class="wa-inbox__rm-filter">
                                <t t-foreach="state.counts.assigned_rms" t-as="rm" t-key="rm.id">
                                    <button
                                        t-attf-class="wa-inbox__rm-pill {{ state.assignedRms.includes(rm.id) ? 'wa-inbox__rm-pill--active' : '' }}"
                                        t-on-click="() => this.toggleRmFilter(rm.id)">
                                        <t t-esc="rm.name"/>
                                        <span class="wa-inbox__rm-pill-count" t-esc="rm.count"/>
                                    </button>
                                </t>
                            </div>
                        </t>
                    </div>

                    <!-- The scrollable list -->
                    <div class="wa-inbox__list">
                        <t t-if="state.listLoading and state.conversations.length === 0">
                            <div class="wa-inbox__loading"><i class="fa fa-spinner fa-spin"/></div>
                        </t>
                        <t t-elif="state.listError">
                            <div class="wa-inbox__error" t-esc="state.listError"/>
                        </t>
                        <t t-elif="sortedConversations.length === 0">
                            <div class="wa-inbox__empty">No conversations found</div>
                        </t>
                        <t t-else="">
                            <t t-foreach="sortedConversations" t-as="conv" t-key="conv.id">
                                <CdConversationListItem
                                    conversation="conv"
                                    selected="state.activeConvId === conv.id"
                                    onSelect="() => this.openThread(conv.id)"
                                    onViewLead="(id) => this.openLead(id)"
                                    onClaim="(id) => this.quickClaim(id)"
                                    onAssign="(id) => this.quickAssign(id)"
                                    waiting="waitingFor(conv) or undefined"/>
                            </t>
                        </t>
                    </div>
                </div>

                <!-- ════ Pane 2: chat ════ -->
                <div class="wa-inbox__chat">
                    <t t-if="state.activeConvId">
                        <div class="wa-inbox__thread-header">
                            <button class="wa-inbox__back-btn"
                                    t-on-click="() => this.closeThread()" title="Back to list">
                                <i class="fa fa-arrow-left" aria-hidden="true"/>
                            </button>
                            <div class="wa-inbox__thread-name">
                                <span t-esc="activeConversation ? (activeConversation.lead_name || activeConversation.phone) : ''"/>
                                <small class="text-muted" t-esc="activeConversation ? activeConversation.phone : ''"/>
                            </div>
                            <div class="wa-inbox__thread-badges">
                                <CdWindowBadge state="windowState" windowExpiresAt="windowExpiresAt"/>
                                <span class="wa-inbox__rm-chip" title="RM this chat is assigned to">
                                    <i class="fa fa-user-circle-o" aria-hidden="true"/>
                                    <t t-esc="(activeConversation and activeConversation.assigned_user_name) ? activeConversation.assigned_user_name : 'Unassigned'"/>
                                </span>
                            </div>
                            <div class="wa-inbox__thread-actions">
                                <button class="btn btn-sm btn-outline-primary"
                                        t-on-click="() => this.openTemplatePicker()">
                                    <i class="fa fa-envelope-o" aria-hidden="true"/> Template
                                </button>
                                <t t-if="activeConversation and activeConversation.lead_id">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            t-on-click="() => this.openLead(activeConversation.lead_id)">
                                        <i class="fa fa-user" aria-hidden="true"/> View Lead
                                    </button>
                                </t>
                                <t t-if="isOrphanChat">
                                    <button class="btn btn-sm btn-outline-success"
                                            t-on-click="() => this.openCreateLead()"
                                            title="This number isn't linked to a lead yet">
                                        <i class="fa fa-user-plus" aria-hidden="true"/> Create lead
                                    </button>
                                </t>
                                <t t-if="activeConversation and activeConversation.interakt_url">
                                    <button class="btn btn-sm btn-outline-success"
                                            t-on-click="() => this.openInInterakt(activeConversation.interakt_url)">
                                        <i class="fa fa-external-link" aria-hidden="true"/> Interakt
                                    </button>
                                </t>
                            </div>
                        </div>

                        <!-- Inquiry-attribution bar: which property this chat is currently about. -->
                        <CdInquirySwitcher
                            segmentsEnabled="segmentsEnabled"
                            activeLabel="activeSegmentLabel"
                            activeInquiryId="activeSegmentInquiryId"
                            inquiries="inquiries"
                            suggestion="segmentSuggestion"
                            onSwitch.bind="switchInquiry"
                            onStartTopic.bind="startTopic"
                            onAcceptSuggestion.bind="acceptSuggestion"
                            onDismissSuggestion.bind="dismissSuggestion"/>

                        <t t-if="state.sendError">
                            <div class="alert alert-danger wa-inbox__send-error" t-esc="state.sendError"/>
                        </t>

                        <!-- Persistent handover-approval banner (assignee/manager) -->
                        <t t-foreach="incomingRequests" t-as="req" t-key="req.id">
                            <div class="wa-inbox__handover-banner">
                                <span class="wa-inbox__handover-text">
                                    <i class="fa fa-user-plus" aria-hidden="true"/>
                                    <b t-esc="req.requester_name"/> requested to take over this chat.
                                    <t t-if="req.note"> — <i t-esc="req.note"/></t>
                                </span>
                                <span class="wa-inbox__handover-actions">
                                    <button class="btn btn-sm btn-success"
                                            t-on-click="() => this.approveRequest(req.id)">
                                        <i class="fa fa-check" aria-hidden="true"/> Approve
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            t-on-click="() => this.declineRequest(req.id)">
                                        <i class="fa fa-times" aria-hidden="true"/> Decline
                                    </button>
                                </span>
                            </div>
                        </t>

                        <t t-if="state.threadLoading and !state.thread">
                            <div class="wa-inbox__loading"><i class="fa fa-spinner fa-spin"/></div>
                        </t>
                        <t t-else="">
                            <CdChatThread messages="activeMessages"/>
                        </t>

                        <t t-if="!canSend">
                            <div class="wa-inbox__claim-bar">
                                <t t-if="assignmentPending">
                                    <span class="wa-inbox__claim-msg">
                                        <i class="fa fa-spinner fa-spin" aria-hidden="true"/>
                                        Assigning…
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="wa-inbox__claim-msg" t-esc="sendGateReason"/>
                                    <t t-if="isUnassigned">
                                        <button class="btn btn-sm btn-primary"
                                                t-on-click="() => this.claimChat()">
                                            <i class="fa fa-hand-paper-o" aria-hidden="true"/> Claim chat
                                        </button>
                                    </t>
                                    <t t-elif="myOpenRequest">
                                        <span class="wa-inbox__claim-msg">
                                            <i class="fa fa-hourglass-half" aria-hidden="true"/>
                                            Request sent — waiting for approval.
                                        </span>
                                    </t>
                                    <t t-else="">
                                        <button class="btn btn-sm btn-outline-primary"
                                                t-on-click="() => this.requestAssignment()">
                                            <i class="fa fa-user-plus" aria-hidden="true"/> Request assignment
                                        </button>
                                    </t>
                                </t>
                            </div>
                        </t>
                        <CdChatComposer
                            windowState="windowState"
                            quickReplies="state.quickReplies"
                            disabled="!canSend"
                            disabledReason="sendGateReason"
                            onSend="(body, kind, opts) => this.onSend(body, kind, opts)"/>
                    </t>

                    <!-- Empty state when no chat is selected -->
                    <t t-else="">
                        <div class="wa-inbox__chat-empty">
                            <i class="fa fa-whatsapp wa-inbox__chat-empty-icon" aria-hidden="true"/>
                            <div class="wa-inbox__chat-empty-title">Pick a conversation</div>
                            <div class="wa-inbox__chat-empty-sub">
                                Select a chat on the left to read the thread and reply.
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Send-template modal -->
            <t t-if="state.showTemplatePicker">
                <CdTemplatePickerModal
                    templates="state.templates"
                    loading="state.tplLoading"
                    error="state.tplError"
                    defaultBodyValue1="activeConversation and activeConversation.lead_name ? activeConversation.lead_name : ''"
                    onSend="(payload) => this.sendTemplate(payload)"
                    onClose="() => this.closeTemplatePicker()"
                    onRefresh="() => this._loadTemplates()"/>
            </t>

            <!-- Create-lead-from-chat modal (orphan / phone-only conversations) -->
            <t t-if="state.showCreateLead">
                <div class="wa-inbox__modal-overlay" t-on-click="() => this.closeCreateLead()">
                    <div class="wa-inbox__create-lead" t-on-click.stop="">
                        <div class="wa-inbox__create-lead-header">
                            <span><i class="fa fa-user-plus" aria-hidden="true"/> Create lead from chat</span>
                            <button class="wa-inbox__create-lead-close"
                                    t-on-click="() => this.closeCreateLead()">×</button>
                        </div>
                        <div class="wa-inbox__create-lead-body">
                            <label class="wa-inbox__cl-label">Name</label>
                            <input type="text" class="wa-inbox__cl-input"
                                   t-att-value="state.createLeadName"
                                   t-on-input="(ev) => this.onCreateLeadName(ev)"
                                   placeholder="Lead name"/>

                            <label class="wa-inbox__cl-label">Phone</label>
                            <input type="text" class="wa-inbox__cl-input" readonly="readonly"
                                   t-att-value="activeConversation ? activeConversation.phone : ''"/>

                            <label class="wa-inbox__cl-label">Property (optional)</label>
                            <AutoComplete
                                value="state.propertyQuery"
                                sources="propertySources"
                                placeholder="'Search property…'"
                                onInput="(args) => this.onPropertyInput(args)"
                                class="'wa-inbox__cl-autocomplete'"/>
                            <t t-if="state.selectedProperty">
                                <div class="wa-inbox__cl-hint">
                                    <i class="fa fa-info-circle" aria-hidden="true"/>
                                    Lead will route to this property's RM.
                                </div>
                            </t>

                            <t t-if="state.createLeadError">
                                <div class="alert alert-danger mt-2" t-esc="state.createLeadError"/>
                            </t>
                        </div>
                        <div class="wa-inbox__create-lead-footer">
                            <button class="btn btn-light"
                                    t-on-click="() => this.closeCreateLead()">Cancel</button>
                            <button class="btn btn-primary"
                                    t-att-disabled="state.createLeadSaving"
                                    t-on-click="() => this.saveLead()">
                                <t t-if="state.createLeadSaving">
                                    <i class="fa fa-spinner fa-spin" aria-hidden="true"/> Saving…
                                </t>
                                <t t-else="">Create lead</t>
                            </button>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
