<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <t t-name="wa_communication.WaDashboard">
    <div class="o-wa-dashboard">

      <!-- ── Header ──────────────────────────────────────────────────── -->
      <div class="o-wa-dashboard__header">
        <div class="o-wa-dashboard__header-left">
          <h1 class="o-wa-dashboard__title">WhatsApp Dashboard</h1>
          <t t-if="state.lastFetched">
            <span class="o-wa-dashboard__last-fetched">
              Last fetched: <t t-esc="state.lastFetched"/>
            </span>
          </t>
        </div>
        <div class="o-wa-dashboard__header-right">
          <button class="btn btn-sm btn-primary o-wa-dashboard__refresh-btn"
                  t-on-click="onRefresh">
            <i class="fa fa-refresh"/> Refresh
          </button>
        </div>
      </div>

      <!-- ── Filters ─────────────────────────────────────────────────── -->
      <div class="o-wa-dashboard__filters">
        <div class="o-wa-dashboard__filter-group">

          <!-- ── Date filter ── -->
          <div class="o-wa-dashboard__dropdown-wrap">
            <button
              t-att-class="'o-wa-dashboard__filter-btn' + (state.showDatePicker ? ' o-wa-dashboard__filter-btn--active' : '')"
              t-on-click="() => { state.showDatePicker = !state.showDatePicker; state.showWorkflowMenu = false; }">
              <i class="fa fa-calendar-o o-wa-dashboard__filter-icon"/>
              <span class="o-wa-dashboard__filter-label"><t t-esc="state.dateLabel"/></span>
              <i class="fa fa-chevron-down o-wa-dashboard__filter-chevron"/>
            </button>

            <t t-if="state.showDatePicker">
              <div class="o-wa-dashboard__dropdown o-wa-dashboard__date-picker">
                <div class="o-wa-dashboard__date-inputs">
                  <label>From
                    <input type="date"
                           t-att-value="state.customFrom"
                           t-on-change="(e) => state.customFrom = e.target.value"/>
                  </label>
                  <label>To
                    <input type="date"
                           t-att-value="state.customTo"
                           t-on-change="(e) => state.customTo = e.target.value"/>
                  </label>
                </div>
                <div class="o-wa-dashboard__presets">
                  <button t-on-click="onPresetToday">Today</button>
                  <button t-on-click="onPresetYesterday">Yesterday</button>
                  <button t-on-click="onPresetCurrentMonth">Current Month</button>
                  <button t-on-click="onPresetLastMonth">Last Month</button>
                  <button t-on-click="onPresetLast30Days">Last 30 Days</button>
                  <button t-on-click="onPresetLast90Days">Last 90 Days</button>
                  <button t-on-click="onPresetYearToDate">Year to Date</button>
                  <button class="o-wa-dashboard__apply-btn"
                          t-on-click="onApplyCustomRange">
                    Apply Custom Range
                  </button>
                </div>
              </div>
            </t>
          </div>

          <!-- ── Workflow multi-select filter ── -->
          <div class="o-wa-dashboard__dropdown-wrap">
            <button
              t-att-class="'o-wa-dashboard__filter-btn' + (state.workflowSlugs.length > 0 ? ' o-wa-dashboard__filter-btn--active' : '') + (state.showWorkflowMenu ? ' o-wa-dashboard__filter-btn--open' : '')"
              t-on-click="() => { state.showWorkflowMenu = !state.showWorkflowMenu; state.showDatePicker = false; }">
              <i class="fa fa-filter o-wa-dashboard__filter-icon"/>
              <span class="o-wa-dashboard__filter-label"><t t-esc="workflowFilterLabel"/></span>
              <i class="fa fa-chevron-down o-wa-dashboard__filter-chevron"/>
            </button>

            <t t-if="state.showWorkflowMenu">
              <div class="o-wa-dashboard__dropdown o-wa-dashboard__workflow-menu">
                <div class="o-wa-dashboard__workflow-search-wrap">
                  <i class="fa fa-search o-wa-dashboard__workflow-search-icon"/>
                  <input type="text"
                         class="o-wa-dashboard__workflow-search"
                         placeholder="Search workflows..."
                         t-att-value="state.workflowSearch"
                         t-on-input="(e) => state.workflowSearch = e.target.value"/>
                </div>
                <ul class="o-wa-dashboard__workflow-list">
                  <!-- "All Workflows" — clears filter -->
                  <li class="o-wa-dashboard__wf-item"
                      t-on-click="() => this.onClearWorkflowFilter()">
                    <span t-att-class="'o-wa-dashboard__wf-check' + (state.workflowSlugs.length === 0 ? ' o-wa-dashboard__wf-check--checked' : '')">
                      <i t-if="state.workflowSlugs.length === 0" class="fa fa-check"/>
                    </span>
                    <span class="o-wa-dashboard__wf-name">All Workflows</span>
                  </li>
                  <!-- Individual workflows -->
                  <t t-foreach="filteredWorkflows" t-as="wf" t-key="wf.id">
                    <li class="o-wa-dashboard__wf-item"
                        t-on-click="() => this.onFilterWorkflow(wf)">
                      <span t-att-class="'o-wa-dashboard__wf-check' + (state.workflowSlugs.includes(wf.slug) ? ' o-wa-dashboard__wf-check--checked' : '')">
                        <i t-if="state.workflowSlugs.includes(wf.slug)" class="fa fa-check"/>
                      </span>
                      <span class="o-wa-dashboard__wf-name"><t t-esc="wf.name"/></span>
                      <span t-if="wf.is_active"  class="o-wa-dashboard__wf-dot o-wa-dashboard__wf-dot--active"/>
                      <span t-if="!wf.is_active" class="o-wa-dashboard__wf-dot o-wa-dashboard__wf-dot--paused"/>
                    </li>
                  </t>
                </ul>
                <div class="o-wa-dashboard__workflow-footer">
                  <button class="o-wa-dashboard__workflow-done-btn"
                          t-on-click="() => this.onCloseWorkflowMenu()">
                    Done
                  </button>
                </div>
              </div>
            </t>
          </div>

        </div>
      </div>

      <!-- ── Loading state ───────────────────────────────────────────── -->
      <t t-if="state.loading and !metricsReady">
        <div class="o-wa-dashboard__loading">Loading dashboard data...</div>
      </t>

      <!-- ── Metric cards grid ────────────────────────────────────────── -->
      <t t-if="metricsReady">
        <div class="o-wa-dashboard__metrics-grid">

          <CdMetricCard
            label="'Messages Sent'"
            value="fmt(state.metrics.sent)"
            trend="trendOf('sent')"
            trendLabel="trendLabel"
          />

          <CdMetricCard
            label="'Delivered'"
            value="fmt(state.metrics.delivered)"
            subValue="fmtRate(state.metrics.delivery_rate)"
          />

          <CdMetricCard
            label="'Read'"
            value="fmt(state.metrics.read)"
            subValue="fmtRate(state.metrics.read_rate)"
          />

          <CdMetricCard
            label="'Failed'"
            value="fmt(state.metrics.failed)"
            variant="failedVariant"
            trend="trendOf('failed')"
            trendLabel="trendLabel"
            breakdown="failedBreakdownText"
          />

          <CdMetricCard
            label="'Active Enrollments'"
            value="fmt(state.metrics.active_enrollments)"
          />

          <CdMetricCard
            label="'Replied'"
            value="fmt(state.metrics.replied)"
            subValue="fmtRate(state.metrics.reply_rate) + ' Reply Rate'"
            trend="trendOf('replied')"
            trendLabel="trendLabel"
          />

        </div>
      </t>

      <!-- ── Two-panel section (Workflow Health + Line Chart) ─────────── -->
      <div class="o-wa-dashboard__panels">

        <!-- Workflow Health -->
        <div class="o-wa-dashboard__section o-wa-dashboard__section--health">
          <div class="o-wa-dashboard__section-header">
            <span class="o-wa-dashboard__section-title">Workflow Health</span>
            <div class="o-wa-dashboard__time-range-tabs">
              <t t-foreach="['12h','24h','7d','30d']" t-as="r" t-key="r">
                <button
                  t-att-class="'o-wa-dashboard__range-tab ' + (state.healthTimeRange === r ? 'o-wa-dashboard__range-tab--active' : '')"
                  t-on-click="() => this.onHealthTimeRangeChange(r)">
                  <t t-esc="r"/>
                </button>
              </t>
              <button
                t-att-class="'o-wa-dashboard__range-tab o-wa-dashboard__range-tab--custom ' + (state.healthTimeRange === 'custom' ? 'o-wa-dashboard__range-tab--active' : '')"
                t-on-click="() => state.showHealthCustomPicker = !state.showHealthCustomPicker">
                <i class="fa fa-calendar-o"/> Custom
              </button>
            </div>
          </div>
          <!-- Inline custom range picker for health section -->
          <t t-if="state.showHealthCustomPicker">
            <div class="o-wa-dashboard__custom-range-bar">
              <input type="date"
                     t-att-value="state.healthCustomFrom"
                     t-on-change="(e) => state.healthCustomFrom = e.target.value"/>
              <span class="o-wa-dashboard__custom-range-sep">to</span>
              <input type="date"
                     t-att-value="state.healthCustomTo"
                     t-on-change="(e) => state.healthCustomTo = e.target.value"/>
              <button class="o-wa-dashboard__custom-range-apply"
                      t-on-click="onApplyHealthCustomRange">
                Apply
              </button>
            </div>
          </t>
          <CdWorkflowHealthTable
            rows="state.workflowHealth"
            onToggle="(id) => this.onToggleWorkflow(id)"
            loading="state.loading"
          />
        </div>

        <!-- Line Chart -->
        <div class="o-wa-dashboard__section o-wa-dashboard__section--chart">
          <div class="o-wa-dashboard__section-header">
            <span class="o-wa-dashboard__section-title">Send Volume</span>
            <div class="o-wa-dashboard__time-range-tabs">
              <t t-foreach="['12h','24h','7d','30d']" t-as="r" t-key="r">
                <button
                  t-att-class="'o-wa-dashboard__range-tab ' + (state.chartTimeRange === r ? 'o-wa-dashboard__range-tab--active' : '')"
                  t-on-click="() => this.onChartTimeRangeChange(r)">
                  <t t-esc="r"/>
                </button>
              </t>
              <button
                t-att-class="'o-wa-dashboard__range-tab o-wa-dashboard__range-tab--custom ' + (state.chartTimeRange === 'custom' ? 'o-wa-dashboard__range-tab--active' : '')"
                t-on-click="() => state.showChartCustomPicker = !state.showChartCustomPicker">
                <i class="fa fa-calendar-o"/> Custom
              </button>
            </div>
          </div>
          <!-- Inline custom range picker for chart section -->
          <t t-if="state.showChartCustomPicker">
            <div class="o-wa-dashboard__custom-range-bar">
              <input type="date"
                     t-att-value="state.chartCustomFrom"
                     t-on-change="(e) => state.chartCustomFrom = e.target.value"/>
              <span class="o-wa-dashboard__custom-range-sep">to</span>
              <input type="date"
                     t-att-value="state.chartCustomTo"
                     t-on-change="(e) => state.chartCustomTo = e.target.value"/>
              <button class="o-wa-dashboard__custom-range-apply"
                      t-on-click="onApplyChartCustomRange">
                Apply
              </button>
            </div>
          </t>
          <CdLineChart bars="state.hourlyData"/>
        </div>

      </div>

      <!-- ── Recent Failures ──────────────────────────────────────────── -->
      <div class="o-wa-dashboard__section o-wa-dashboard__section--failures">
        <div class="o-wa-dashboard__section-header">
          <span class="o-wa-dashboard__section-title">Recent Failures</span>
        </div>
        <CdRecentFailuresTable
          rows="state.failures"
          onOpenLead="(leadId) => this.onOpenLead(leadId)"
        />
      </div>

    </div>
  </t>

</templates>

