<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <t t-name="wa_communication.WaDashboard">
    <div class="o-wa-dashboard">

      <!-- ── Header ──────────────────────────────────────────────────── -->
      <div class="o-wa-dashboard__header">
        <div class="o-wa-dashboard__header-left">
          <h1 class="o-wa-dashboard__title">WhatsApp Dashboard</h1>
          <t t-if="state.lastFetched">
            <span class="o-wa-dashboard__last-fetched">
              Last fetched: <t t-esc="state.lastFetched"/>
            </span>
          </t>
        </div>
        <div class="o-wa-dashboard__header-right">
          <button class="btn btn-sm btn-primary o-wa-dashboard__refresh-btn"
                  t-on-click="onRefresh">
            <i class="fa fa-refresh"/> Refresh
          </button>
        </div>
      </div>

      <!-- ── Filters ─────────────────────────────────────────────────── -->
      <div class="o-wa-dashboard__filters">
        <div class="o-wa-dashboard__filter-group">

          <!-- ── Date filter ── -->
          <div class="o-wa-dashboard__dropdown-wrap">
            <button
              t-att-class="'o-wa-dashboard__filter-btn' + (state.showDatePicker ? ' o-wa-dashboard__filter-btn--active' : '')"
              t-on-click="() => { state.showDatePicker = !state.showDatePicker; state.showWorkflowMenu = false; }">
              <i class="fa fa-calendar-o o-wa-dashboard__filter-icon"/>
              <span class="o-wa-dashboard__filter-label"><t t-esc="state.dateLabel"/></span>
              <i class="fa fa-chevron-down o-wa-dashboard__filter-chevron"/>
            </button>

            <t t-if="state.showDatePicker">
              <div class="o-wa-dashboard__dropdown o-wa-dashboard__date-picker">
                <div class="o-wa-dashboard__date-inputs">
                  <label>From
                    <input type="date"
                           t-att-value="state.customFrom"
                           t-on-change="(e) => state.customFrom = e.target.value"/>
                  </label>
                  <label>To
                    <input type="date"
                           t-att-value="state.customTo"
                           t-on-change="(e) => state.customTo = e.target.value"/>
                  </label>
                </div>
                <div class="o-wa-dashboard__presets">
                  <button t-on-click="onPresetToday">Today</button>
                  <button t-on-click="onPresetYesterday">Yesterday</button>
                  <button t-on-click="onPresetCurrentMonth">Current Month</button>
                  <button t-on-click="onPresetLastMonth">Last Month</button>
                  <button t-on-click="onPresetLast30Days">Last 30 Days</button>
                  <button t-on-click="onPresetLast90Days">Last 90 Days</button>
                  <button t-on-click="onPresetYearToDate">Year to Date</button>
                  <button class="o-wa-dashboard__apply-btn"
                          t-on-click="onApplyCustomRange">
                    Apply Custom Range
                  </button>
                </div>
              </div>
            </t>
          </div>

          <!-- ── Workflow multi-select filter ── -->
          <div class="o-wa-dashboard__dropdown-wrap">
            <button
              t-att-class="'o-wa-dashboard__filter-btn' + (state.workflowSlugs.length > 0 ? ' o-wa-dashboard__filter-btn--active' : '') + (state.showWorkflowMenu ? ' o-wa-dashboard__filter-btn--open' : '')"
              t-on-click="() => { state.showWorkflowMenu = !state.showWorkflowMenu; state.showDatePicker = false; }">
              <i class="fa fa-filter o-wa-dashboard__filter-icon"/>
              <span class="o-wa-dashboard__filter-label"><t t-esc="workflowFilterLabel"/></span>
              <i class="fa fa-chevron-down o-wa-dashboard__filter-chevron"/>
            </button>

            <t t-if="state.showWorkflowMenu">
              <div class="o-wa-dashboard__dropdown o-wa-dashboard__workflow-menu">
                <div class="o-wa-dashboard__workflow-search-wrap">
                  <i class="fa fa-search o-wa-dashboard__workflow-search-icon"/>
                  <input type="text"
                         class="o-wa-dashboard__workflow-search"
                         placeholder="Search workflows..."
                         t-att-value="state.workflowSearch"
                         t-on-input="(e) => state.workflowSearch = e.target.value"/>
                </div>
                <ul class="o-wa-dashboard__workflow-list">
                  <!-- "All Workflows" — clears filter -->
                  <li class="o-wa-dashboard__wf-item"
                      t-on-click="() => this.onClearWorkflowFilter()">
                    <span t-att-class="'o-wa-dashboard__wf-check' + (state.workflowSlugs.length === 0 ? ' o-wa-dashboard__wf-check--checked' : '')">
                      <i t-if="state.workflowSlugs.length === 0" class="fa fa-check"/>
                    </span>
                    <span class="o-wa-dashboard__wf-name">All Workflows</span>
                  </li>
                  <!-- Individual workflows -->
                  <t t-foreach="filteredWorkflows" t-as="wf" t-key="wf.id">
                    <li class="o-wa-dashboard__wf-item"
                        t-on-click="() => this.onFilterWorkflow(wf)">
                      <span t-att-class="'o-wa-dashboard__wf-check' + (state.workflowSlugs.includes(wf.slug) ? ' o-wa-dashboard__wf-check--checked' : '')">
                        <i t-if="state.workflowSlugs.includes(wf.slug)" class="fa fa-check"/>
                      </span>
                      <span class="o-wa-dashboard__wf-name"><t t-esc="wf.name"/></span>
                      <span t-if="wf.is_active"  class="o-wa-dashboard__wf-dot o-wa-dashboard__wf-dot--active"/>
                      <span t-if="!wf.is_active" class="o-wa-dashboard__wf-dot o-wa-dashboard__wf-dot--paused"/>
                    </li>
                  </t>
                </ul>
                <div class="o-wa-dashboard__workflow-footer">
                  <button class="o-wa-dashboard__workflow-done-btn"
                          t-on-click="() => this.onCloseWorkflowMenu()">
                    Done
                  </button>
                </div>
              </div>
            </t>
          </div>

        </div>
      </div>

      <!-- ── Tabs ────────────────────────────────────────────────────── -->
      <div class="o-wa-dashboard__tabs">
        <t t-foreach="[['command','Command Center'],['overview','Overview'],['rm','By RM'],['property','By Property'],['campaign','By Campaign']]" t-as="tb" t-key="tb[0]">
          <button t-att-class="'o-wa-dashboard__tab' + (state.activeTab === tb[0] ? ' o-wa-dashboard__tab--active' : '')"
                  t-on-click="() => this.onSwitchTab(tb[0])">
            <t t-esc="tb[1]"/>
          </button>
        </t>
      </div>

      <!-- ════════════════════════ COMMAND CENTER ══════════════════════ -->
      <t t-if="state.activeTab === 'command'">
        <t t-if="state.commandLoading and !state.command">
          <div class="o-wa-dashboard__loading">Loading…</div>
        </t>
        <t t-if="state.command">
          <!-- Headline KPI cards -->
          <div class="o-wa-kpi-grid">
            <t t-foreach="kpiCards" t-as="k" t-key="k.label">
              <CdKpiCard label="k.label" value="k.value" sub="k.sub or ''"
                         delta="k.delta" invert="k.invert or false"
                         spark="k.spark or []" tooltip="k.tooltip or ''"/>
            </t>
          </div>

          <!-- Trend charts -->
          <div class="o-wa-dashboard__panels">
            <div class="o-wa-dashboard__section">
              <div class="o-wa-dashboard__section-header">
                <span class="o-wa-dashboard__section-title">Volume &amp; replies</span>
              </div>
              <CdChart type="'line'" data="volumeChart.data" options="volumeChart.options"
                       height="200" ariaLabel="'Daily sent messages and replies'"/>
            </div>
            <div class="o-wa-dashboard__section">
              <div class="o-wa-dashboard__section-header">
                <span class="o-wa-dashboard__section-title">Failures</span>
              </div>
              <CdChart type="'bar'" data="healthChart.data" options="healthChart.options"
                       height="200" ariaLabel="'Daily failed messages'"/>
            </div>
          </div>

          <!-- Action worklists -->
          <div class="o-wa-worklist-grid">
            <CdWorklistPanel title="'Needs reply'" icon="'fa-reply'" accent="'danger'"
                             count="state.worklists.needs_reply.count"
                             buckets="needsReplyBuckets" rows="needsReplyRows"
                             onRowClick="(r) => this.openConversation(r)"
                             emptyText="'No unanswered chats — nice.'"/>
            <CdWorklistPanel title="'Window closing'" icon="'fa-hourglass-half'" accent="'warn'"
                             count="state.worklists.window_closing.count"
                             rows="windowClosingRows"
                             onRowClick="(r) => this.openConversation(r)"
                             emptyText="'No 24h windows closing soon.'"/>
            <CdWorklistPanel title="'Unassigned'" icon="'fa-user-plus'" accent="'info'"
                             count="state.worklists.unassigned.count"
                             rows="unassignedRows"
                             onRowClick="(r) => this.openConversation(r)"
                             emptyText="'Every active chat is assigned.'"/>
          </div>
        </t>
      </t>

      <!-- ════════════════════════ BY RM ═══════════════════════════════ -->
      <t t-if="state.activeTab === 'rm'">
        <div class="o-wa-dashboard__section">
          <div class="o-wa-dashboard__section-header">
            <span class="o-wa-dashboard__section-title">RM responsiveness</span>
            <div class="o-wa-dashboard__prop-search">
              <i class="fa fa-search"/>
              <input type="text" placeholder="Search RM…"
                     t-att-value="state.rmSearch"
                     t-on-input="(e) => this.onRmSearchInput(e.target.value)"/>
            </div>
          </div>
          <t t-if="state.rmLoading">
            <div class="o-wa-dashboard__loading">Loading…</div>
          </t>
          <t t-else="">
            <CdLeaderboardTable columns="rmColumns" rows="rmFilteredRows"
                                defaultSort="'reply_rate'"
                                emptyText="'No RM activity in this period.'"/>
          </t>
        </div>
      </t>

      <!-- ════════════════════════ BY CAMPAIGN ═════════════════════════ -->
      <t t-if="state.activeTab === 'campaign'">
        <div class="o-wa-dashboard__section">
          <div class="o-wa-dashboard__section-header">
            <span class="o-wa-dashboard__section-title">Workflows</span>
            <div class="o-wa-dashboard__prop-search">
              <i class="fa fa-search"/>
              <input type="text" placeholder="Search…"
                     t-att-value="state.campaignSearch"
                     t-on-input="(e) => this.onCampaignSearchInput(e.target.value)"/>
            </div>
          </div>
          <t t-if="state.campaignLoading">
            <div class="o-wa-dashboard__loading">Loading…</div>
          </t>
          <t t-else="">
            <CdLeaderboardTable columns="campaignWorkflowColumns" rows="campaignWorkflowRows"
                                defaultSort="'sent'"
                                emptyText="'No workflow sends in this period.'"/>
          </t>
        </div>
        <div class="o-wa-dashboard__section">
          <div class="o-wa-dashboard__section-header">
            <span class="o-wa-dashboard__section-title">Templates</span>
          </div>
          <CdLeaderboardTable columns="campaignTemplateColumns" rows="campaignTemplateRows"
                              defaultSort="'sent'"
                              emptyText="'No template sends in this period.'"/>
        </div>
      </t>

      <!-- ════════════════════════ OVERVIEW TAB ════════════════════════ -->
      <t t-if="state.activeTab === 'overview'">

      <!-- ── Loading state ───────────────────────────────────────────── -->
      <t t-if="state.loading and !metricsReady">
        <div class="o-wa-dashboard__loading">Loading dashboard data...</div>
      </t>

      <!-- ── Metric cards grid ────────────────────────────────────────── -->
      <t t-if="metricsReady">
        <div class="o-wa-dashboard__metrics-grid">

          <CdMetricCard
            label="'Messages Sent'"
            value="fmt(state.metrics.sent)"
            trend="state.metrics.trend.sent"
            trendLabel="trendLabel"
          />

          <CdMetricCard
            label="'Delivered'"
            value="fmt(state.metrics.delivered)"
            subValue="fmtRate(state.metrics.delivery_rate)"
          />

          <CdMetricCard
            label="'Read'"
            value="fmt(state.metrics.read)"
            subValue="fmtRate(state.metrics.read_rate)"
          />

          <CdMetricCard
            label="'Failed'"
            value="fmt(state.metrics.failed)"
            variant="failedVariant"
            trend="state.metrics.trend.failed"
            trendLabel="trendLabel"
            breakdown="failedBreakdownText"
          />

          <CdMetricCard
            label="'Active Enrollments'"
            value="fmt(state.metrics.active_enrollments)"
          />

          <CdMetricCard
            label="'Replied'"
            value="fmt(state.metrics.replied)"
            subValue="fmtRate(state.metrics.reply_rate) + ' Reply Rate'"
            trend="state.metrics.trend.replied"
            trendLabel="trendLabel"
          />

        </div>
      </t>

      <!-- ── Two-panel section (Workflow Health + Line Chart) ─────────── -->
      <div class="o-wa-dashboard__panels">

        <!-- Workflow Health -->
        <div class="o-wa-dashboard__section o-wa-dashboard__section--health">
          <div class="o-wa-dashboard__section-header">
            <span class="o-wa-dashboard__section-title">Workflow Health</span>
            <div class="o-wa-dashboard__time-range-tabs">
              <t t-foreach="['12h','24h','7d','30d']" t-as="r" t-key="r">
                <button
                  t-att-class="'o-wa-dashboard__range-tab ' + (state.healthTimeRange === r ? 'o-wa-dashboard__range-tab--active' : '')"
                  t-on-click="() => this.onHealthTimeRangeChange(r)">
                  <t t-esc="r"/>
                </button>
              </t>
              <button
                t-att-class="'o-wa-dashboard__range-tab o-wa-dashboard__range-tab--custom ' + (state.healthTimeRange === 'custom' ? 'o-wa-dashboard__range-tab--active' : '')"
                t-on-click="() => state.showHealthCustomPicker = !state.showHealthCustomPicker">
                <i class="fa fa-calendar-o"/> Custom
              </button>
            </div>
          </div>
          <!-- Inline custom range picker for health section -->
          <t t-if="state.showHealthCustomPicker">
            <div class="o-wa-dashboard__custom-range-bar">
              <input type="date"
                     t-att-value="state.healthCustomFrom"
                     t-on-change="(e) => state.healthCustomFrom = e.target.value"/>
              <span class="o-wa-dashboard__custom-range-sep">to</span>
              <input type="date"
                     t-att-value="state.healthCustomTo"
                     t-on-change="(e) => state.healthCustomTo = e.target.value"/>
              <button class="o-wa-dashboard__custom-range-apply"
                      t-on-click="onApplyHealthCustomRange">
                Apply
              </button>
            </div>
          </t>
          <CdWorkflowHealthTable
            rows="state.workflowHealth"
            onToggle="(id) => this.onToggleWorkflow(id)"
            loading="state.loading"
          />
        </div>

        <!-- Line Chart -->
        <div class="o-wa-dashboard__section o-wa-dashboard__section--chart">
          <div class="o-wa-dashboard__section-header">
            <span class="o-wa-dashboard__section-title">Send Volume</span>
            <div class="o-wa-dashboard__time-range-tabs">
              <t t-foreach="['12h','24h','7d','30d']" t-as="r" t-key="r">
                <button
                  t-att-class="'o-wa-dashboard__range-tab ' + (state.chartTimeRange === r ? 'o-wa-dashboard__range-tab--active' : '')"
                  t-on-click="() => this.onChartTimeRangeChange(r)">
                  <t t-esc="r"/>
                </button>
              </t>
              <button
                t-att-class="'o-wa-dashboard__range-tab o-wa-dashboard__range-tab--custom ' + (state.chartTimeRange === 'custom' ? 'o-wa-dashboard__range-tab--active' : '')"
                t-on-click="() => state.showChartCustomPicker = !state.showChartCustomPicker">
                <i class="fa fa-calendar-o"/> Custom
              </button>
            </div>
          </div>
          <!-- Inline custom range picker for chart section -->
          <t t-if="state.showChartCustomPicker">
            <div class="o-wa-dashboard__custom-range-bar">
              <input type="date"
                     t-att-value="state.chartCustomFrom"
                     t-on-change="(e) => state.chartCustomFrom = e.target.value"/>
              <span class="o-wa-dashboard__custom-range-sep">to</span>
              <input type="date"
                     t-att-value="state.chartCustomTo"
                     t-on-change="(e) => state.chartCustomTo = e.target.value"/>
              <button class="o-wa-dashboard__custom-range-apply"
                      t-on-click="onApplyChartCustomRange">
                Apply
              </button>
            </div>
          </t>
          <CdLineChart bars="state.hourlyData"/>
        </div>

      </div>

      <!-- ── Recent Failures ──────────────────────────────────────────── -->
      <div class="o-wa-dashboard__section o-wa-dashboard__section--failures">
        <div class="o-wa-dashboard__section-header">
          <span class="o-wa-dashboard__section-title">Recent Failures</span>
        </div>
        <CdRecentFailuresTable
          rows="state.failures"
          onOpenLead="(leadId) => this.onOpenLead(leadId)"
        />
      </div>

      </t><!-- /Overview tab -->

      <!-- ════════════════════════ BY-PROPERTY TAB ═════════════════════ -->
      <t t-if="state.activeTab === 'property'">

        <!-- WhatsApp-rescue KPI cards -->
        <t t-if="state.rescue">
          <div class="o-wa-dashboard__metrics-grid">
            <CdMetricCard
              label="'Hard-to-Reach Leads'"
              value="fmt(state.rescue.overall.cohort)"
              subValue="'unreachable by phone'"
            />
            <CdMetricCard
              label="'WhatsApp Re-engaged'"
              value="fmtRate(state.rescue.overall.rescue_engagement_rate)"
              subValue="fmt(state.rescue.overall.rescue_engaged) + ' replied on WA'"
            />
            <CdMetricCard
              label="'WA-Attributed Close Rate'"
              value="fmtRate(state.rescue.overall.wa_attributed_close_rate)"
              subValue="fmt(state.rescue.overall.rescued_to_visit) + ' of ' + fmt(state.rescue.overall.rescued) + ' booked → visited'"
            />
          </div>
          <div class="o-wa-dashboard__rescue-note">
            <i class="fa fa-info-circle"/>
            <span t-esc="state.rescue.note"/>
          </div>
        </t>

        <!-- Ranked property table -->
        <div class="o-wa-dashboard__section">
          <div class="o-wa-dashboard__section-header">
            <span class="o-wa-dashboard__section-title">
              WhatsApp by Property
              <t t-if="state.propertyTotal"> (<t t-esc="state.propertyTotal"/>)</t>
            </span>
            <div class="o-wa-dashboard__prop-search">
              <i class="fa fa-search"/>
              <input type="text" placeholder="Search property..."
                     t-att-value="state.propertySearch"
                     t-on-input="(e) => this.onPropertySearchInput(e.target.value)"
                     t-on-keydown="(e) => e.key === 'Enter' &amp;&amp; this.onApplyPropertySearch()"/>
            </div>
          </div>

          <t t-if="state.propertyLoading">
            <div class="o-wa-dashboard__loading">Loading…</div>
          </t>
          <t t-elif="!state.propertyRows.length">
            <div class="o-wa-dashboard__empty">No WhatsApp activity in this period.</div>
          </t>
          <t t-else="">
            <table class="o-wa-prop-table">
              <thead>
                <tr>
                  <th>Property</th>
                  <th class="o-num" t-on-click="() => this.onPropertySort('leads')">Leads</th>
                  <th class="o-num" t-on-click="() => this.onPropertySort('messages')">Msgs</th>
                  <th class="o-num">In / Out</th>
                  <th class="o-num" t-on-click="() => this.onPropertySort('reply_rate')">Reply</th>
                  <th class="o-num" t-on-click="() => this.onPropertySort('response')">Response</th>
                  <th class="o-num" t-on-click="() => this.onPropertySort('conversion')">Conv.</th>
                  <th class="o-num">Rescue</th>
                  <th class="o-num" t-on-click="() => this.onPropertySort('cost')">Cost</th>
                  <th class="o-num" t-on-click="() => this.onPropertySort('last_activity')">Last</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="state.propertyRows" t-as="row" t-key="row.property_id || 'unassigned'">
                  <tr t-att-class="'o-wa-prop-row' + (row.property_id ? ' o-clickable' : '') + (state.expandedPropertyId === row.property_id ? ' o-expanded' : '')"
                      t-on-click="() => this.onToggleProperty(row.property_id)">
                    <td>
                      <i t-if="row.property_id" class="fa o-wa-prop-caret"
                         t-att-class="state.expandedPropertyId === row.property_id ? 'fa-caret-down' : 'fa-caret-right'"/>
                      <span t-esc="row.property_name"/>
                    </td>
                    <td class="o-num" t-esc="row.leads_engaged"/>
                    <td class="o-num" t-esc="row.messages_total"/>
                    <td class="o-num"><t t-esc="row.inbound"/> / <t t-esc="row.outbound"/></td>
                    <td class="o-num" t-esc="fmtRate(row.reply_rate)"/>
                    <td class="o-num" t-esc="fmtSecs(row.response_secs_median)"/>
                    <td class="o-num">
                      <t t-esc="fmtRate(row.conversion_rate)"/>
                      <span class="o-wa-prop-sub"><t t-esc="row.visits_done"/>/<t t-esc="row.leads_engaged"/></span>
                    </td>
                    <td class="o-num">
                      <t t-set="resc" t-value="rescueForProperty(row.property_id)"/>
                      <t t-if="resc and resc.cohort" t-esc="fmtRate(resc.rescue_engagement_rate)"/>
                      <t t-else="">—</t>
                    </td>
                    <td class="o-num" t-esc="fmtCost(row.cost)"/>
                    <td class="o-num" t-esc="fmtDateTime(row.last_activity)"/>
                  </tr>

                  <!-- Drill-down: per-inquiry rows -->
                  <t t-if="state.expandedPropertyId === row.property_id">
                    <tr class="o-wa-inq-wrap">
                      <td colspan="10">
                        <t t-if="state.inquiryLoading">
                          <div class="o-wa-dashboard__loading">Loading inquiries…</div>
                        </t>
                        <t t-else="">
                          <table class="o-wa-inq-table">
                            <thead>
                              <tr>
                                <th>Lead</th><th>Phone</th><th>Type</th>
                                <th class="o-num">Msgs</th><th class="o-num">Response</th>
                                <th class="o-num">Cost</th><th>Site visit</th>
                                <th class="o-num">Last</th><th/>
                              </tr>
                            </thead>
                            <tbody>
                              <t t-foreach="state.inquiryRows" t-as="inq" t-key="inq.inquiry_id || 'na'">
                                <tr>
                                  <td t-esc="inq.lead_name"/>
                                  <td t-esc="inq.phone"/>
                                  <td t-esc="inq.inquiry_type"/>
                                  <td class="o-num" t-esc="inq.messages_total"/>
                                  <td class="o-num" t-esc="fmtSecs(inq.response_secs)"/>
                                  <td class="o-num" t-esc="fmtCost(inq.cost)"/>
                                  <td>
                                    <span t-if="inq.visit_status"
                                          t-att-class="'o-wa-visit-pill' + (inq.visit_done ? ' o-done' : '')"
                                          t-esc="inq.visit_status"/>
                                    <span t-else="" class="o-wa-prop-sub">—</span>
                                  </td>
                                  <td class="o-num" t-esc="fmtDateTime(inq.last_activity)"/>
                                  <td class="o-num">
                                    <button t-if="inq.inquiry_id" class="btn btn-link btn-sm o-wa-open-btn"
                                            t-on-click="() => this.onOpenLead(inq.inquiry_id)"
                                            title="Open lead">
                                      <i class="fa fa-external-link"/>
                                    </button>
                                  </td>
                                </tr>
                              </t>
                              <t t-if="!state.inquiryRows.length">
                                <tr><td colspan="9" class="o-wa-dashboard__empty">No inquiries.</td></tr>
                              </t>
                            </tbody>
                          </table>
                        </t>
                      </td>
                    </tr>
                  </t>
                </t>
              </tbody>
            </table>
          </t>
        </div>

      </t><!-- /By-Property tab -->

    </div>
  </t>

</templates>

