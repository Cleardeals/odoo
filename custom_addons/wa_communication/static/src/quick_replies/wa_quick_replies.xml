<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wa_communication.WaQuickReplies">
        <div class="wa-qr">
            <div class="wa-qr__header">
                <div>
                    <h2 class="wa-qr__title">
                        <i class="fa fa-bolt" aria-hidden="true"/> Quick Replies
                    </h2>
                    <p class="wa-qr__subtitle">
                        Save canned messages to insert into any WhatsApp chat.
                    </p>
                </div>
                <button class="btn btn-primary wa-qr__new-btn" t-on-click="() => this.newReply()">
                    <i class="fa fa-plus" aria-hidden="true"/> New quick reply
                </button>
            </div>

            <t t-if="state.loading">
                <div class="wa-qr__loading"><i class="fa fa-spinner fa-spin"/></div>
            </t>

            <t t-else="">
                <!-- Personal -->
                <div class="wa-qr__section-title">
                    <i class="fa fa-user" aria-hidden="true"/> My quick replies
                </div>
                <div class="wa-qr__grid">
                    <t t-if="personalReplies.length === 0">
                        <div class="wa-qr__empty">No personal quick replies yet.</div>
                    </t>
                    <t t-foreach="personalReplies" t-as="r" t-key="r.id">
                        <t t-call="wa_communication.WaQuickReplyCard"/>
                    </t>
                </div>

                <!-- Shared -->
                <div class="wa-qr__section-title">
                    <i class="fa fa-users" aria-hidden="true"/> Shared with the team
                    <t t-if="!state.isManager">
                        <span class="wa-qr__readonly-tag">read-only</span>
                    </t>
                </div>
                <div class="wa-qr__grid">
                    <t t-if="sharedReplies.length === 0">
                        <div class="wa-qr__empty">No shared quick replies.</div>
                    </t>
                    <t t-foreach="sharedReplies" t-as="r" t-key="r.id">
                        <t t-call="wa_communication.WaQuickReplyCard"/>
                    </t>
                </div>
            </t>

            <!-- Editor modal -->
            <t t-if="state.editing">
                <div class="wa-qr__overlay" t-on-click="() => this.cancelEdit()">
                    <div class="wa-qr__modal" t-on-click.stop="() => {}">
                        <div class="wa-qr__modal-header">
                            <span t-esc="state.editing.id ? 'Edit quick reply' : 'New quick reply'"/>
                            <button class="wa-qr__modal-close" t-on-click="() => this.cancelEdit()">×</button>
                        </div>
                        <div class="wa-qr__modal-body">
                            <label class="wa-qr__label">Title</label>
                            <input type="text" class="wa-qr__input" placeholder="e.g. Site visit confirm"
                                   t-att-value="state.editing.title"
                                   t-on-input="(ev) => { this.state.editing.title = ev.target.value; }"/>

                            <label class="wa-qr__label">Shortcut (optional)</label>
                            <input type="text" class="wa-qr__input" placeholder="/visit"
                                   t-att-value="state.editing.shortcut"
                                   t-on-input="(ev) => { this.state.editing.shortcut = ev.target.value; }"/>

                            <label class="wa-qr__label">Type</label>
                            <div class="wa-qr__kind-toggle">
                                <button type="button"
                                        t-att-class="'wa-qr__kind-opt' + (state.editing.kind === 'text' ? ' wa-qr__kind-opt--active' : '')"
                                        t-on-click="() => this.setEditorKind('text')">
                                    <i class="fa fa-align-left" aria-hidden="true"/> Text
                                </button>
                                <button type="button"
                                        t-att-class="'wa-qr__kind-opt' + (state.editing.kind === 'list' ? ' wa-qr__kind-opt--active' : '')"
                                        t-on-click="() => this.setEditorKind('list')">
                                    <i class="fa fa-list-ul" aria-hidden="true"/> List message
                                </button>
                            </div>

                            <label class="wa-qr__label">
                                <t t-esc="state.editing.kind === 'list' ? 'List body text' : 'Message'"/>
                            </label>
                            <t t-if="state.editing.kind === 'text'">
                                <div class="wa-qr__fmt-bar">
                                    <button class="wa-qr__fmt-btn" type="button" title="Bold (*text*)"
                                            t-on-click="() => this.applyFormat('*')"><b>B</b></button>
                                    <button class="wa-qr__fmt-btn" type="button" title="Italic (_text_)"
                                            t-on-click="() => this.applyFormat('_')"><i>I</i></button>
                                    <button class="wa-qr__fmt-btn" type="button" title="Strikethrough (~text~)"
                                            t-on-click="() => this.applyFormat('~')"><s>S</s></button>
                                    <button class="wa-qr__fmt-btn" type="button" title="Monospace (```text```)"
                                            t-on-click="() => this.applyFormat('```')"><code>&lt;/&gt;</code></button>
                                </div>
                            </t>
                            <textarea class="wa-qr__textarea" t-att-rows="state.editing.kind === 'list' ? 2 : 5" t-ref="editorBody"
                                      placeholder="Type the message…"
                                      t-att-value="state.editing.body"
                                      t-on-input="(ev) => { this.state.editing.body = ev.target.value; }"/>

                            <!-- List builder (kind='list') — reuses composer .cd-list-builder styles -->
                            <t t-if="state.editing.kind === 'list'">
                                <!-- Live WhatsApp preview: collapsed bubble + the list it opens -->
                                <div class="cd-list-builder__preview wa-qr__preview">
                                    <div class="cd-list-builder__preview-label">Preview</div>
                                    <div class="cd-list-builder__preview-bubble">
                                        <div class="cd-list-builder__preview-text"
                                             t-esc="state.editing.body.trim() || 'List body text…'"/>
                                        <div class="cd-list-builder__preview-btn">
                                            <i class="fa fa-list-ul" aria-hidden="true"/>
                                            <span t-esc="state.editing.list.button.trim() || 'Button'"/>
                                        </div>
                                    </div>
                                    <t t-if="previewRows.length">
                                        <div class="wa-qr__preview-sheet">
                                            <t t-foreach="previewRows" t-as="pr" t-key="pr_index">
                                                <div class="wa-qr__preview-row">
                                                    <div class="wa-qr__preview-row-title" t-esc="pr.title"/>
                                                    <t t-if="pr.description">
                                                        <div class="wa-qr__preview-row-desc" t-esc="pr.description"/>
                                                    </t>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                </div>

                                <label class="wa-qr__label">
                                    List button label
                                    <span class="cd-list-builder__hint">max <t t-esc="LIMITS.button"/></span>
                                </label>
                                <input type="text" class="wa-qr__input" placeholder="e.g. View options"
                                       t-att-maxlength="LIMITS.button"
                                       t-att-value="state.editing.list.button"
                                       t-on-input="(ev) => { this.state.editing.list.button = ev.target.value; }"/>

                                <label class="wa-qr__label">Sections &amp; items (<t t-esc="listRowCount"/>/<t t-esc="LIMITS.maxRows"/>)</label>
                                <t t-foreach="state.editing.list.sections" t-as="sec" t-key="sec_index">
                                    <div class="cd-list-builder__section">
                                        <div class="cd-list-builder__section-head">
                                            <input type="text" class="cd-list-builder__input cd-list-builder__section-title"
                                                   placeholder="Section title (optional)"
                                                   t-att-maxlength="LIMITS.sectionTitle"
                                                   t-att-value="sec.title"
                                                   t-on-input="(ev) => { sec.title = ev.target.value; }"/>
                                            <button class="cd-list-builder__icon-btn"
                                                    t-if="state.editing.list.sections.length > 1"
                                                    title="Remove section"
                                                    t-on-click="() => this.removeSection(sec_index)">
                                                <i class="fa fa-trash" aria-hidden="true"/>
                                            </button>
                                        </div>
                                        <t t-foreach="sec.rows" t-as="row" t-key="row_index">
                                            <div class="cd-list-builder__row">
                                                <span class="cd-list-builder__row-num" t-esc="row_index + 1"/>
                                                <div class="cd-list-builder__row-fields">
                                                    <div class="cd-list-builder__row-title-wrap">
                                                        <input type="text" class="cd-list-builder__input"
                                                               placeholder="Item title (required)"
                                                               t-att-maxlength="LIMITS.rowTitle"
                                                               t-att-value="row.title"
                                                               t-on-input="(ev) => { row.title = ev.target.value; }"/>
                                                        <span t-attf-class="cd-list-builder__counter {{ (row.title || '').length >= LIMITS.rowTitle ? 'cd-list-builder__counter--max' : '' }}">
                                                            <t t-esc="(row.title || '').length"/>/<t t-esc="LIMITS.rowTitle"/>
                                                        </span>
                                                    </div>
                                                    <input type="text" class="cd-list-builder__input"
                                                           placeholder="Description (optional)"
                                                           t-att-maxlength="LIMITS.rowDesc"
                                                           t-att-value="row.description"
                                                           t-on-input="(ev) => { row.description = ev.target.value; }"/>
                                                </div>
                                                <button class="cd-list-builder__icon-btn"
                                                        t-if="sec.rows.length > 1"
                                                        title="Remove item"
                                                        t-on-click="() => this.removeRow(sec_index, row_index)">
                                                    <i class="fa fa-times" aria-hidden="true"/>
                                                </button>
                                            </div>
                                        </t>
                                        <button class="cd-list-builder__add-link"
                                                t-on-click="() => this.addRow(sec_index)">
                                            <i class="fa fa-plus" aria-hidden="true"/> Add item
                                        </button>
                                    </div>
                                </t>
                                <button class="cd-list-builder__add-link cd-list-builder__add-section"
                                        t-on-click="() => this.addSection()">
                                    <i class="fa fa-plus" aria-hidden="true"/> Add section
                                </button>
                            </t>

                            <t t-if="state.isManager">
                                <label class="wa-qr__check">
                                    <input type="checkbox"
                                           t-att-checked="state.editing.is_shared"
                                           t-on-change="(ev) => { this.state.editing.is_shared = ev.target.checked; }"/>
                                    Share with the whole team
                                </label>
                            </t>
                        </div>
                        <div class="wa-qr__modal-footer">
                            <button class="btn btn-secondary" t-on-click="() => this.cancelEdit()">Cancel</button>
                            <button class="btn btn-primary" t-att-disabled="state.saving"
                                    t-on-click="() => this.save()">
                                <t t-if="state.saving"><i class="fa fa-spinner fa-spin"/></t>
                                <t t-else="">Save</t>
                            </button>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

    <!-- Reusable card -->
    <t t-name="wa_communication.WaQuickReplyCard">
        <div class="wa-qr__card">
            <div class="wa-qr__card-head">
                <t t-if="r.kind === 'list'">
                    <span class="wa-qr__card-list-badge" title="Interactive list message">
                        <i class="fa fa-list-ul" aria-hidden="true"/>
                    </span>
                </t>
                <span class="wa-qr__card-title" t-esc="r.title"/>
                <t t-if="r.shortcut">
                    <span class="wa-qr__card-shortcut" t-esc="r.shortcut"/>
                </t>
            </div>
            <div class="wa-qr__card-body" t-out="bodyHtml(r.body)"/>
            <div class="wa-qr__card-actions">
                <t t-if="canEdit(r)">
                    <button class="wa-qr__icon-btn" title="Edit" t-on-click="() => this.editReply(r)">
                        <i class="fa fa-pencil" aria-hidden="true"/>
                    </button>
                    <button class="wa-qr__icon-btn wa-qr__icon-btn--danger" title="Delete"
                            t-on-click="() => this.remove(r)">
                        <i class="fa fa-trash" aria-hidden="true"/>
                    </button>
                </t>
                <t t-else="">
                    <span class="wa-qr__card-lock"><i class="fa fa-lock" aria-hidden="true"/></span>
                </t>
            </div>
        </div>
    </t>
</templates>
