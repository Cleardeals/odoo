<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    WaNotification: stacked toast notification cards for WA events.
    Fixed to bottom-right corner, z-index 3000.
    BEM prefix: cd-wa-notif (card modifier: replied / review / failure)
  -->
  <t t-name="wa_communication.WaNotification">
    <div class="cd-wa-notif" t-if="state.notifications.length > 0">
      <t t-foreach="state.notifications" t-as="n" t-key="n.id">
        <div t-attf-class="cd-wa-notif__card cd-wa-notif__card--#{n.mod} #{isClickable(n) ? 'cd-wa-notif__card--clickable' : ''}"
             t-on-click="() => isClickable(n) ? this.openLead(n) : null">

          <!-- Header row: icon + title + dismiss -->
          <div class="cd-wa-notif__header">
            <i t-attf-class="fa #{n.icon} cd-wa-notif__icon" />
            <span class="cd-wa-notif__title" t-esc="n.title" />
            <button class="cd-wa-notif__dismiss" t-on-click.stop="() => dismiss(n.id)" title="Dismiss">
              <i class="fa fa-times" />
            </button>
          </div>

          <!-- Lead name / phone -->
          <div t-if="n.leadName" class="cd-wa-notif__lead" t-esc="n.leadName" />

          <!-- Message preview -->
          <div t-if="n.message" class="cd-wa-notif__msg" t-esc="n.message" />

          <!-- Actionable: reassignment approve / decline -->
          <t t-if="n.actionable">
            <div class="cd-wa-notif__actions">
              <button class="cd-wa-notif__btn cd-wa-notif__btn--primary"
                      t-att-disabled="n.busy"
                      t-on-click="() => this.approve(n)">
                <i class="fa fa-check" aria-hidden="true"/> Approve
              </button>
              <button class="cd-wa-notif__btn"
                      t-att-disabled="n.busy"
                      t-on-click="() => this.decline(n)">
                Decline
              </button>
            </div>
          </t>

          <!-- Action row -->
          <t t-elif="isClickable(n)">
            <div class="cd-wa-notif__actions">
              <button class="cd-wa-notif__btn" t-on-click.stop="() => openLead(n)">
                Open chat →
              </button>
            </div>
          </t>

        </div>
      </t>
    </div>
  </t>

</templates>
