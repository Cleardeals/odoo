<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add WhatsApp Activity tab to the leads.new form view -->
    <record id="view_leads_new_form_wa_inherit" model="ir.ui.view">
        <field name="name">leads.new.form.wa_communication</field>
        <field name="model">leads.new</field>
        <field name="inherit_id" ref="leads.view_new_portal_lead_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="WhatsApp Activity" name="wa_activity">
                    <widget name="wa_whatsapp_tab"/>
                </page>
            </notebook>

            <!-- Lock the status until a WhatsApp message has been attempted.
                 The bindings live here rather than in the leads module because
                 wa_status_change_allowed is defined by wa_communication —
                 leads must stay installable on its own. -->
            <xpath expr="//header/field[@name='current_status']" position="before">
                <field name="wa_status_change_allowed" invisible="1"/>
            </xpath>
            <xpath expr="//header/field[@name='current_status']" position="attributes">
                <attribute name="readonly">not wa_status_change_allowed</attribute>
            </xpath>
            <xpath expr="//page[@name='primary_inquiry']//field[@name='current_status']"
                   position="attributes">
                <attribute name="readonly">not wa_status_change_allowed</attribute>
            </xpath>
        </field>
    </record>

    <!-- Same lock in the list view, which is editable in bulk. -->
    <record id="view_leads_new_list_wa_inherit" model="ir.ui.view">
        <field name="name">leads.new.list.wa_communication</field>
        <field name="model">leads.new</field>
        <field name="inherit_id" ref="leads.view_new_portal_lead_list"/>
        <field name="arch" type="xml">
            <field name="current_status" position="before">
                <field name="wa_status_change_allowed" column_invisible="1"/>
            </field>
            <field name="current_status" position="attributes">
                <attribute name="readonly">not wa_status_change_allowed</attribute>
            </field>
        </field>
    </record>
</odoo>
