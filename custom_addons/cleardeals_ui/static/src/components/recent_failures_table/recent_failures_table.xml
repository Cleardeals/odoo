<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <t t-name="cleardeals_ui.RecentFailuresTable">
    <div class="cd-recent-failures-table">
      <t t-if="props.rows.length === 0">
        <div class="cd-recent-failures-table__empty">No recent failures.</div>
      </t>
      <t t-else="">
        <table>
          <thead>
            <tr>
              <th>Lead</th>
              <th>Phone</th>
              <th>Workflow</th>
              <th>Failure Reason</th>
              <th>Time</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="props.rows" t-as="row" t-key="row.id">
              <tr>
                <td class="cd-recent-failures-table__lead">
                  <t t-esc="row.lead_name or '-'"/>
                </td>
                <td><t t-esc="row.phone or '-'"/></td>
                <td><t t-esc="row.workflow_name or '-'"/></td>
                <td class="cd-recent-failures-table__reason">
                  <span t-att-class="'cd-status-badge badge rounded-pill ' + badgeClass(row.failure_status)">
                    <t t-esc="row.failure_label or row.failure_status"/>
                  </span>
                  <div class="cd-recent-failures-table__reason-detail" t-att-title="row.failure_reason">
                    <t t-esc="row.failure_reason"/>
                    <t t-if="row.failure_code"> (code <t t-esc="row.failure_code"/>)</t>
                  </div>
                </td>
                <td class="cd-recent-failures-table__time">
                  <t t-esc="formatTime(row.occurred_at)"/>
                </td>
                <td>
                  <t t-if="row.lead_id">
                    <button
                      class="cd-open-lead-btn"
                      t-on-click="() => this.handleOpenLead(row)"
                    >
                      Open &#x2192;
                    </button>
                  </t>
                  <t t-else="">
                    <span class="cd-recent-failures-table__no-lead">-</span>
                  </t>
                </td>
              </tr>
            </t>
          </tbody>
        </table>
      </t>
    </div>
  </t>

</templates>
