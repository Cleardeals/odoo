<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <t t-name="cleardeals_ui.WorkflowHealthTable">
    <div class="cd-workflow-health-table">
      <t t-if="props.loading">
        <div class="cd-workflow-health-table__loading">Loading...</div>
      </t>
      <t t-else="">
        <table>
          <thead>
            <tr>
              <th>Workflow</th>
              <th>Status</th>
              <th>Sent</th>
              <th>Del %</th>
              <th>Failed</th>
              <th>On/Off</th>
            </tr>
          </thead>
          <tbody>
            <t t-if="props.rows.length === 0">
              <tr>
                <td colspan="6" class="cd-workflow-health-table__empty">
                  No workflows found.
                </td>
              </tr>
            </t>
            <t t-foreach="props.rows" t-as="row" t-key="row.id">
              <tr>
                <td class="cd-workflow-health-table__name">
                  <t t-esc="row.name"/>
                </td>
                <td>
                  <span t-att-class="'cd-wf-badge ' + (row.is_active ? 'cd-wf-badge--active' : 'cd-wf-badge--paused')">
                    <t t-if="row.is_active">Active</t>
                    <t t-else="">Paused</t>
                  </span>
                </td>
                <td><t t-esc="row.sent"/></td>
                <td><t t-esc="row.delivery_rate"/>%</td>
                <td><t t-esc="row.failed"/></td>
                <td>
                  <div
                    t-att-class="'cd-toggle ' + (row.is_active ? 'cd-toggle--on' : '')"
                    t-on-click="() => this.handleToggle(row)"
                    title="Toggle workflow active state"
                  >
                    <div class="cd-toggle__slider"/>
                  </div>
                </td>
              </tr>
            </t>
          </tbody>
        </table>
      </t>
    </div>
  </t>

</templates>
