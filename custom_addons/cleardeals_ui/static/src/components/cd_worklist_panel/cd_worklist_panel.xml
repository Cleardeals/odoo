<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <t t-name="cleardeals_ui.CdWorklistPanel">
    <div t-att-class="'cd-worklist' + (props.accent ? ' cd-worklist--' + props.accent : '')">

      <div class="cd-worklist__head">
        <span class="cd-worklist__title">
          <i t-if="props.icon" t-att-class="'fa ' + props.icon" aria-hidden="true"/>
          <t t-esc="props.title"/>
        </span>
        <span class="cd-worklist__count"><t t-esc="props.count or 0"/></span>
      </div>

      <t t-if="props.buckets.length">
        <div class="cd-worklist__buckets">
          <t t-foreach="props.buckets" t-as="b" t-key="b.label">
            <button t-att-class="'cd-worklist__chip'
                        + (b.tone ? ' cd-worklist__chip--' + b.tone : '')
                        + (props.onBucketClick ? ' cd-worklist__chip--btn' : '')
                        + (props.activeBucket and props.activeBucket === (b.key || b.label) ? ' cd-worklist__chip--active' : '')"
                    t-att-disabled="props.onBucketClick ? undefined : 'disabled'"
                    t-att-aria-pressed="props.activeBucket and props.activeBucket === (b.key || b.label) ? 'true' : 'false'"
                    t-on-click="() => this.onBucket(b)">
              <span class="cd-worklist__chip-count"><t t-esc="b.value"/></span>
              <span class="cd-worklist__chip-label"><t t-esc="b.label"/></span>
            </button>
          </t>
        </div>
      </t>

      <div class="cd-worklist__rows">
        <t t-if="props.rows.length">
          <t t-foreach="props.rows" t-as="row" t-key="row_index">
            <button t-att-class="'cd-worklist__row' + (row.tone ? ' cd-worklist__row--' + row.tone : '')"
                    t-on-click="() => this.onClick(row)">
              <span class="cd-worklist__row-main">
                <span class="cd-worklist__row-title"><t t-esc="row.title"/></span>
                <span t-if="row.sub" class="cd-worklist__row-sub"><t t-esc="row.sub"/></span>
              </span>
              <span t-if="row.meta" t-att-class="'cd-worklist__row-meta' + (row.tone ? ' cd-worklist__row-meta--' + row.tone : '')"><t t-esc="row.meta"/></span>
              <i class="fa fa-angle-right cd-worklist__row-caret" aria-hidden="true"/>
            </button>
          </t>
        </t>
        <t t-else="">
          <div class="cd-worklist__empty"><t t-esc="props.emptyText"/></div>
        </t>
      </div>

    </div>
  </t>

</templates>
