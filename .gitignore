# sphinx build directories
_build/

# dotfiles
.*

# The blanket ".*" above hides dotfiles that MUST be committed.
# .dockerignore controls what enters the Docker build context, and
# .gcloudignore what Cloud Build uploads. If either is missing from the
# repo, CI silently builds a different image from the one built locally.
!.dockerignore
!.gcloudignore
!.gitignore
!.gitattributes
!.gitkeep
!.github
!.mailmap
!.weblate.json
# compiled python files
*.py[co]
__pycache__/
# setup.py egg_info
*.egg-info
# emacs backup files
*~
# hg stuff
*.orig
status
# odoo filestore
odoo/filestore
# maintenance migration scripts
odoo/addons/base/maintenance
# windows installation config file
/odoo.conf
/odoo_development.conf

# generated for windows installer?
install/win32/*.bat
install/win32/meta.py

# needed only when building for win32
setup/win32/static/less/
setup/win32/static/wkhtmltopdf/
setup/win32/static/postgresql*.exe

# js tooling
node_modules
jsconfig.json
tsconfig.json
package-lock.json
package.json
.husky

# various virtualenv
/bin/
/build/
/dist/
/include/
/lib/
/man/
/share/
/src/
venv
# Database Backups
*.sql
*.zip


# IDE and OS specific files
.vscode/
.idea/
.DS_Store

odoo-db-data/
odoo-web-data/
odoo-dev-db-data/
odoo-dev-web-data/

docker-compose.override.yml

letsencrypt/

hrms_addons/

# Claude Code: team-share skills only; keep the rest of .claude local
!.claude/
.claude/*
!.claude/skills/
.claude/skills/product-brainstorm-workspace/

# Personal handoff note. Untracked by design and routinely stale — it also
# carries infrastructure and access notes that must never reach this PUBLIC
# repo. It was swept into a commit once by `git add -A`; this closes that.
CHECKPOINT.md

# ML-matching design scratch: mockups, wireframes and generated HTML stay local.
# Written as contents-plus-negation, NOT a bare `docs/ml_matching/`, because git
# cannot re-include a file whose parent directory is excluded — and the numbered
# design docs at the top of this directory ARE tracked on
# feature/ml-matching-integration. A bare directory ignore would silently
# swallow the next one added to that series.
docs/ml_matching/*
!docs/ml_matching/*.md
